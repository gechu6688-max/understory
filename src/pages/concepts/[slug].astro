---
import LocaleRedirect from "../../components/LocaleRedirect.astro";
import { getDiscoveryCases, getTaxonomyItems } from "../../lib/cases";

export async function getStaticPaths() {
  const cases = await getDiscoveryCases();
  return getTaxonomyItems(cases, "concepts").map((concept) => ({
    params: { slug: concept.slug },
    props: { slug: concept.slug },
  }));
}

const { slug } = Astro.props;
---

<LocaleRedirect to={`/en/concepts/${slug}/`} />
