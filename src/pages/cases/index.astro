---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPublishedCases } from "../../lib/cases";
import { siteCopy } from "../../lib/siteCopy";

const publishedCases = await getPublishedCases();
---

<BaseLayout title="Cases" description="Published business analysis cases.">
  <section class="page-shell cases-page" aria-labelledby="cases-heading">
    <div class="library-hero">
      <div>
        <p class="home-eyebrow">Cases</p>
        <h1 id="cases-heading">Analysis library</h1>
      </div>
      <div class="library-hero__panel">
        <strong>{publishedCases.length === 1 ? "1 published case" : `${publishedCases.length} published cases`}</strong>
        <p>Public entries only. Drafts, reviews, and archived cases stay out of this library.</p>
      </div>
    </div>

    <section class="library-discovery" aria-label="Case library discovery">
      <p>{siteCopy.search.placeholder}</p>
      <span>Browse the public library by question, company, topic, and concept as it grows.</span>
    </section>

    <ol class="library-list">
      {
        publishedCases.map((caseEntry) => (
          <li>
            <div class="library-list__meta">
              <time datetime={caseEntry.data.publishedDate.toISOString()}>{formatDate(caseEntry.data.publishedDate)}</time>
              <span>{caseEntry.data.caseType} case</span>
            </div>
            <div class="library-list__body">
              <h2>
                <a href={`/cases/${caseEntry.id}/`}>{caseEntry.data.title}</a>
              </h2>
              <p class="library-question">{caseEntry.data.centralQuestion}</p>
              <p>{caseEntry.data.summary}</p>
              <dl class="library-taxonomy">
                <div>
                  <dt>Entities</dt>
                  <dd>{caseEntry.data.entities.join(", ")}</dd>
                </div>
                <div>
                  <dt>Topics</dt>
                  <dd>{caseEntry.data.topics.join(", ")}</dd>
                </div>
                <div>
                  <dt>Concepts</dt>
                  <dd>{caseEntry.data.concepts.join(", ")}</dd>
                </div>
              </dl>
            </div>
            <a class="library-read" href={`/cases/${caseEntry.id}/`}>Read -></a>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
