---
import { getCollection } from "astro:content";
import CaseArticle from "../../components/CaseArticle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases", ({ data }) => data.status === "published");

  return cases.map((caseEntry) => ({
    params: { slug: caseEntry.id },
    props: { caseEntry },
  }));
}

const { caseEntry } = Astro.props;
---

<BaseLayout title={caseEntry.data.title} description={caseEntry.data.summary}>
  <CaseArticle caseEntry={caseEntry} />
</BaseLayout>
