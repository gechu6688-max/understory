---
import LocaleRedirect from "../../components/LocaleRedirect.astro";
import { getPublishedCases } from "../../lib/cases";

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return cases.map((caseEntry) => ({
    params: { slug: caseEntry.id },
    props: { slug: caseEntry.id },
  }));
}

const { slug } = Astro.props;
---

<LocaleRedirect to={`/en/cases/${slug}/`} />
