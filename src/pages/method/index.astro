---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteCopy } from "../../lib/siteCopy";

const methodSteps = siteCopy.method.steps;
---

<BaseLayout title="Method" description="The analytical method behind understory.">
  <section class="page-shell method-page method-page--path" aria-labelledby="method-heading">
    <div class="method-hero">
      <div>
        <p class="home-eyebrow">Method</p>
        <h1 id="method-heading">A thinking path for unfinished questions</h1>
      </div>
      <p>The method is designed for readable business thinking: clear questions, visible evidence, serious alternatives, careful judgement, and curiosity that continues after the conclusion.</p>
    </div>

    <section class="method-panel" aria-labelledby="method-sequence-heading">
      <div>
        <p class="home-eyebrow">Analytical Sequence</p>
        <h2 id="method-sequence-heading">A conclusion should sharpen curiosity.</h2>
      </div>
      <ol class="home-method-list method-path">
        {
          methodSteps.map((step, index) => (
            <li>
              <details class="method-step" open>
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <h3>{step.label}</h3>
                    <p>{step.short}</p>
                  </div>
                </summary>
                <p class="method-step__body">{step.text}</p>
              </details>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="method-notes" aria-labelledby="standards-heading">
      <h2 id="standards-heading">Working standards</h2>
      <ul>
        <li>Evidence and interpretation should be visibly different.</li>
        <li>Legal complaints, company filings, academic arguments, and datasets should not be treated as the same kind of source.</li>
        <li>Uncertainty is named when claims are still draft, alleged, incomplete, or dependent on better data.</li>
        <li>References stay visible so readers can inspect the source base behind a case.</li>
        <li>Each conclusion should include what would weaken or change it.</li>
        <li>A conclusion should sharpen curiosity, not end it.</li>
      </ul>
    </section>
  </section>
  <script is:inline>
    const syncMethodDisclosure = () => {
      const shouldCollapse = window.matchMedia("(max-width: 640px)").matches;
      document.querySelectorAll(".method-step").forEach((step) => {
        if (step instanceof HTMLDetailsElement) {
          step.open = !shouldCollapse;
        }
      });
    };

    syncMethodDisclosure();
    window.matchMedia("(max-width: 640px)").addEventListener("change", syncMethodDisclosure);
  </script>
</BaseLayout>
