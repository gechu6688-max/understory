---
import LocaleRedirect from "../../components/LocaleRedirect.astro";
import { getPublishedCases, getTaxonomyItems } from "../../lib/cases";

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return getTaxonomyItems(cases, "topics").map((topic) => ({
    params: { slug: topic.slug },
    props: { slug: topic.slug },
  }));
}

const { slug } = Astro.props;
---

<LocaleRedirect to={`/en/topics/${slug}/`} />
