---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { getCaseDisplayData, getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath, topicDescriptions } from "../../../lib/siteCopy";
import ResearchSymbol from "../../../components/discovery/ResearchSymbol.astro";
import ConceptDiagram from "../../../components/discovery/ConceptDiagram.astro";
import { discoveryContent } from "../../../lib/discovery";

export async function getStaticPaths() {
  const publishedCases = await getDiscoveryCases();
  const topics = getTaxonomyItems(publishedCases, "topics");
  return locales.flatMap((locale) => topics.map((topic) => ({ params: { locale, slug: topic.slug }, props: { topic } })));
}

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const { topic } = Astro.props;
const topicCases = locale === "zh" ? topic.cases.filter((caseEntry) => hasCaseLocale(locale, caseEntry.id)) : topic.cases;
const caseCount = locale === "zh" ? `${topicCases.length} 个公开案例` : topicCases.length === 1 ? "1 public case" : `${topicCases.length} public cases`;
const detail = discoveryContent(locale, topic.name);
const relatedConcepts = getTaxonomyItems(topicCases, "concepts", locale);
const topicNumber = getTaxonomyItems(await getDiscoveryCases(), "topics").findIndex((item) => item.slug === topic.slug) + 1;
---

<BaseLayout title={topic.name} description={`Published cases about ${topic.name}.`} locale={locale}>
  <section class="page-shell" aria-labelledby="topic-heading">
    <Breadcrumbs
      label={locale === "zh" ? "页面路径" : "Breadcrumb"}
      items={[
        { label: locale === "zh" ? "首页" : "Home", href: localizedPath(locale) },
        { label: copy.pages.topics.eyebrow, href: localizedPath(locale, "/topics/") },
        { label: topic.name },
      ]}
    />
    <div class="taxonomy-identity taxonomy-identity--topic">
      <div><p class="discovery-kicker">{locale === "zh" ? "主题" : "Topic"} / {String(topicNumber).padStart(2, "0")}</p><h1 id="topic-heading">{topic.name}</h1><p>{detail.framing}</p><small>{caseCount} · {relatedConcepts.length} {locale === "zh" ? "个相关概念" : "related concepts"}</small></div><ResearchSymbol kind={topic.slug} label={topic.name} />
    </div>
    <section class="understanding"><p class="discovery-kicker">{locale === "zh" ? "理解这个主题" : "Understanding the topic"}</p><p>{topicDescriptions[locale][topic.name] ?? topicDescriptions.en[topic.name]}</p></section>
    <section class="follow-questions"><p class="discovery-kicker">{locale === "zh" ? "我们正在追问" : "Questions we follow"}</p><ol>{[detail.question, ...detail.signals].map((question, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{question}</p></li>)}</ol></section>
    <section class="taxonomy-cases"><p class="discovery-kicker">{locale === "zh" ? "这个主题中的研究" : "Cases in this topic"}</p>
      {topicCases.map((caseEntry) => {
        const displayData = getCaseDisplayData(caseEntry, locale);

        return (
          <article><img src={caseEntry.data.heroImage} alt=""/><div><span>{locale === "zh" ? "案例" : "Case"} {caseEntry.data.caseNumber ?? "001"}</span><h2><a href={localizedPath(locale, `/cases/${caseEntry.id}/`)}>{displayData.title}</a></h2><p>{displayData.centralQuestion}</p></div></article>
        );
      })}
    </section>
    <section class="related-concepts"><p class="discovery-kicker">{locale === "zh" ? "帮助理解的概念" : "Concepts that help explain it"}</p><div>{relatedConcepts.map((concept) => <a href={localizedPath(locale, `/concepts/${concept.slug}/`)}><ConceptDiagram concept={concept.slug} label={concept.name}/><span>{concept.name}</span></a>)}</div></section>
    <section class="discovery-closing"><p>{locale === "zh" ? "继续沿着问题探索。" : "Continue following the question."}</p><div><a href={localizedPath(locale, "/topics/")}>{locale === "zh" ? "所有主题 →" : "All topics →"}</a><a href={localizedPath(locale, "/concepts/")}>{locale === "zh" ? "浏览概念 →" : "Browse concepts →"}</a></div></section>
    {topicCases.length === 0 && locale === "zh" && (
      <p class="library-empty">
        {copy.pages.topics.empty} <a class="cta-link" href={localizedPath("en", `/topics/${topic.slug}/`)}>阅读英文主题 -></a>
      </p>
    )}
  </section>
</BaseLayout>
