---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResearchLandscape from "../../../components/discovery/ResearchLandscape.astro";
import ResearchSymbol from "../../../components/discovery/ResearchSymbol.astro";
import { getCaseDisplayData, getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath, topicDescriptions } from "../../../lib/siteCopy";
import { discoveryContent } from "../../../lib/discovery";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en"; const copy=getSiteCopy(locale); const zh=locale==="zh";
const all=await getDiscoveryCases(); const cases=locale==="zh"?all.filter((entry)=>hasCaseLocale(locale,entry.id)):all; const topics=getTaxonomyItems(cases,"topics"); const feature=cases[0];
---
<BaseLayout title={copy.pages.topics.eyebrow} description={copy.pages.topics.description} locale={locale}>
<section class="page-shell discovery-round2 topics-v21" aria-labelledby="topics-heading">
 <header class="landscape-hero-v21"><div><p class="discovery-kicker">{zh?"主题 / 研究地貌":"Topics / Research Landscape"}</p><h1 id="topics-heading">{zh?"商业世界之下的力量。":"The forces beneath the business world."}</h1><p>{zh?"从真实案例出发，追踪竞争、市场力量与它们之间的关系。":"Follow the forces, structures, and questions that shape a business world."}</p></div><ResearchLandscape locale={locale}/></header>
 <section class="topic-module-grid" aria-label={zh?"主题模块":"Topic modules"}>{topics.map((topic,index)=><article class:list={["topic-module",`topic-module--${topic.slug}`]}><div class="topic-module__top"><span>{String(index+1).padStart(2,"0")}</span><ResearchSymbol kind={topic.slug} label={topic.name}/></div><h2>{topic.name}</h2><p>{topicDescriptions[locale][topic.name]??topicDescriptions.en[topic.name]}</p><strong>{discoveryContent(locale,topic.name).question}</strong><footer><small>{topic.cases.length} {zh?"项正式案例":"formal case"}</small><a href={localizedPath(locale,`/topics/${topic.slug}/`)}>{zh?"探索":"Explore"} →</a></footer></article>)}</section>
 {feature && (()=>{const item=getCaseDisplayData(feature,locale);return <section class="attached-research-v21"><figure><img src={feature.data.heroImage} alt={feature.data.heroImageAlt}/></figure><div><p class="discovery-kicker">{zh?"关联研究":"Research attached to the landscape"}</p><span>{zh?"案例":"Case"} {feature.data.caseNumber??"001"}</span><h2>{item.title}</h2><p>{item.centralQuestion}</p><small>{item.topics.join(" · ")} · {item.concepts.join(" · ")}</small><a class="module-link" href={localizedPath(locale,`/cases/${feature.id}/`)}>{zh?"阅读研究":"Read research"} →</a></div></section>})()}
</section></BaseLayout>
