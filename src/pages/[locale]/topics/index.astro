---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getDiscoveryCases } from "../../../lib/cases";
import { hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
import { getPublishedTopics, getTopicCategories } from "../../../lib/topics";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en",zh=locale==="zh";
const all=await getDiscoveryCases(),topics=getPublishedTopics(zh?all.filter((entry)=>hasCaseLocale(locale,entry.id)):all,locale),featured=topics.filter((topic)=>topic.featured).slice(0,4),categories=getTopicCategories(topics);
const L=zh?{eyebrow:"主题",title:"看见表面之下的力量。",intro:"围绕真实企业与市场中反复出现的问题，追问影响商业结果的关键力量。",explore:"探索主题",all:"全部",more:"更多",index:"全部主题",cases:(n:number)=>`${n} 个已发布案例`,concepts:(n:number)=>`关联 ${n} 个概念`,detail:"探索这一主题",qEye:"从问题出发",qTitle:"沿着问题，发现更多主题",view:"查看所有主题",caption:"同样的市场，\n不同的力量，\n更深的问题。",empty:"暂时还没有可展示的已发布主题。"}:{eyebrow:"Topics",title:"The forces behind business outcomes.",intro:"Recurring questions that shape companies, markets, and consumer behaviour.",explore:"Explore topics",all:"All",more:"More",index:"All topics",cases:(n:number)=>`${n} published ${n===1?"case":"cases"}`,concepts:(n:number)=>`${n} related ${n===1?"concept":"concepts"}`,detail:"Explore this theme",qEye:"Key questions",qTitle:"Explore by question",view:"See all topics",caption:"Same markets.\nDifferent forces.\nDeeper questions.",empty:"No published topics are available yet."};
---
<BaseLayout title={L.title} description={L.intro} locale={locale}>
<section class="topics-editorial" aria-labelledby="topics-heading">
  <header class="topics-editorial__hero"><div class="topics-editorial__hero-copy"><p class="topics-editorial__eyebrow">{L.eyebrow}</p><h1 id="topics-heading">{L.title}</h1><p class="topics-editorial__intro">{L.intro}</p><a href="#featured-topics" class="topics-editorial__route">{L.explore} <span>→</span></a></div><figure><img src="https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=1800&q=88" alt={zh?"城市街道与高层建筑。":"A city street framed by tall buildings."} fetchpriority="high"/><figcaption>{L.caption}</figcaption></figure></header>
  {topics.length?<><nav class="topics-editorial__filters" aria-label={zh?"主题筛选":"Topic filters"} data-topic-filters><button type="button" class="is-active" data-topic-filter="all" aria-pressed="true">{L.all}</button>{categories.slice(0,4).map((c)=><button type="button" data-topic-filter={c.id} aria-pressed="false">{c.label}</button>)}{categories.length>4&&<button type="button" data-topic-filter="more" aria-pressed="false">{L.more} ⌄</button>}</nav>
  <section id="featured-topics" class="topics-editorial__featured" aria-label={zh?"精选主题":"Featured topics"}>{featured[0]&&<a class="topic-feature topic-feature--lead" href={localizedPath(locale,`/topics/${featured[0].slug}/`)} data-topic-category={featured[0].category}><figure><img src={featured[0].image} alt={featured[0].imageAlt}/></figure><div><span>01</span><h2>{featured[0].title}</h2><p>{featured[0].keyQuestion}</p><em>{L.detail} <i>→</i></em></div></a>}{featured.slice(1).length>0&&<div class="topic-feature__supporting">{featured.slice(1).map((topic,index)=><a class="topic-feature topic-feature--support" href={localizedPath(locale,`/topics/${topic.slug}/`)} data-topic-category={topic.category}><figure><img src={topic.image} alt={topic.imageAlt} loading="lazy"/></figure><div><span>{String(index+2).padStart(2,"0")}</span><h2>{topic.title}</h2><p>{topic.keyQuestion}</p><i>→</i></div></a>)}</div>}</section>
  <section class="topics-editorial__index" aria-labelledby="topic-index-heading"><header><p class="topics-editorial__eyebrow">{L.index}</p><h2 id="topic-index-heading">{zh?"主题索引":"Topic index"}</h2></header><div class="topics-editorial__index-list">{topics.map((topic,index)=><a href={localizedPath(locale,`/topics/${topic.slug}/`)} data-topic-category={topic.category}><span>{String(index+1).padStart(2,"0")}</span><div><h3>{topic.title}</h3><p>{topic.shortDescription}</p></div><small>{L.cases(topic.relatedCaseIds.length)}<br/>{L.concepts(topic.relatedConceptIds.length)}</small><strong>{topic.keyQuestion}</strong><i>→</i></a>)}</div></section>
  <section class="topics-editorial__questions" aria-labelledby="questions-heading"><header><p class="topics-editorial__eyebrow">{L.qEye}</p><h2 id="questions-heading">{L.qTitle}</h2><a href="#topic-index-heading">{L.view} <span>→</span></a></header><div>{topics.slice(0,6).map((topic)=><a href={localizedPath(locale,`/topics/${topic.slug}/`)} data-topic-category={topic.category} style={`--topic-image: url('${topic.image}')`}><strong>{topic.keyQuestion}</strong><span>→</span></a>)}</div></section></>:<p class="topics-editorial__empty">{L.empty}</p>}
</section>
<script is:inline>document.querySelectorAll("[data-topic-filters]").forEach((filters)=>{const buttons=Array.from(filters.querySelectorAll("[data-topic-filter]")),entries=Array.from(document.querySelectorAll("[data-topic-category]"));buttons.forEach((button)=>button.addEventListener("click",()=>{const category=button.dataset.topicFilter;buttons.forEach((item)=>{const active=item===button;item.classList.toggle("is-active",active);item.setAttribute("aria-pressed",String(active));});entries.forEach((entry)=>entry.toggleAttribute("hidden",category!=="all"&&entry.dataset.topicCategory!==category));}));});</script>
</BaseLayout>
