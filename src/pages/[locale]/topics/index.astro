---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResearchMark from "../../../components/discovery/ResearchMark.astro";
import { getCaseDisplayData, getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath, topicDescriptions } from "../../../lib/siteCopy";
import { discoveryContent } from "../../../lib/discovery";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en"; const copy=getSiteCopy(locale); const zh=locale==="zh";
const all=await getDiscoveryCases(); const cases=locale==="zh"?all.filter((entry)=>hasCaseLocale(locale,entry.id)):all; const topics=getTaxonomyItems(cases,"topics"); const feature=cases[0];
const competition=topics.find(t=>t.slug==="competition"); const power=topics.find(t=>t.slug==="market-power");
const terrainImage="https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=1600&q=85";
const pressureImage="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1400&q=85";
const powerImage="https://images.unsplash.com/photo-1555529771-835f59fc5efe?auto=format&fit=crop&w=1400&q=85";
---
<BaseLayout title={copy.pages.topics.eyebrow} description={copy.pages.topics.description} locale={locale}>
  <section class="topics-r8" aria-labelledby="topics-heading">
    <header class="terrain-r8-hero">
      <div class="terrain-r8-hero__copy"><p class="discovery-kicker">{zh?"主题地貌":"Research terrain"}</p><h1 id="topics-heading">{zh?"商业世界之下的力量。":"A map of forces."}</h1><p>{zh?"从真实案例出发，追踪竞争、市场力量与它们之间的关系。":"A working map of the pressure, room, and friction beneath a business story."}</p><a class="r8-route" href="#pressure">{zh?"探索地貌":"Explore the terrain"}<span aria-hidden="true">↘</span></a></div>
      <figure class="terrain-r8-hero__image"><img src={terrainImage} alt={zh?"为主题地貌提供语境的城市公共空间与人流影像。":"A contextual editorial image of people moving through a built public environment."} /><figcaption><span>People</span><span>Firms</span><span>Markets</span><span>Rules</span><span>Outcomes</span></figcaption></figure>
    </header>
    {competition && (()=>{const data=discoveryContent(locale,competition.name);return <section id="pressure" class="r8-force r8-pressure" aria-labelledby="competition-heading"><header><p class="discovery-kicker">{zh?"压力场":"Pressure field"}</p><h2 id="competition-heading">{competition.name}</h2><p>{topicDescriptions[locale][competition.name]??topicDescriptions.en[competition.name]}</p></header><figure class="r8-force__image"><img src={pressureImage} alt={zh?"用于说明竞争与选择的建筑环境语境影像。":"A contextual editorial image of built systems and alternative routes."}/><figcaption>{zh?"竞争并不抽象；它存在于可实际选择的路径里。":"Competition is felt in routes people can actually take."}</figcaption></figure><aside class="r8-watch"><p>{zh?"观察什么":"What to watch"}</p><ol>{data.signals.slice(0,3).map((signal,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{signal}</li>)}</ol><a class="r8-route" href={localizedPath(locale,`/topics/${competition.slug}/`)}>{zh?"探索竞争":"Explore Competition"}<span aria-hidden="true">↗</span></a></aside></section>})()}
    {power && (()=>{const data=discoveryContent(locale,power.name);return <section class="r8-force r8-power" aria-labelledby="power-heading"><header><p class="discovery-kicker">{zh?"行动空间":"Room to act"}</p><h2 id="power-heading">{power.name}</h2><p>{topicDescriptions[locale][power.name]??topicDescriptions.en[power.name]}</p></header><div class="r8-power__field"><figure><img src={powerImage} alt={zh?"用于说明市场行动空间与基础设施的物流环境语境影像。":"A contextual editorial image of infrastructure and controlled access."}/></figure><div class="r8-power__terms"><b>{zh?"价格":"Price"}</b><b>{zh?"质量":"Quality"}</b><b>{zh?"进入":"Access"}</b><b>{zh?"条款":"Terms"}</b></div><small>{zh?"竞争 · 转换 · 替代品":"Competition · switching · substitutes"}</small></div><aside class="r8-power__reading"><p class="r8-power__question">{data.question}</p><ol>{data.signals.slice(0,3).map((signal,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{signal}</li>)}</ol><a class="r8-route" href={localizedPath(locale,`/topics/${power.slug}/`)}>{zh?"探索市场力量":"Explore Market Power"}<span aria-hidden="true">↗</span></a></aside></section>})()}
    <section class="r8-questions" aria-labelledby="questions-heading"><header><p class="discovery-kicker">{zh?"未决的问题":"Open questions"}</p><h2 id="questions-heading">{zh?"还有什么仍然未定？":"What remains unresolved?"}</h2></header><div class="r8-questions__grid"><a href={localizedPath(locale,"/topics/market-power/")}><span class="r8-question-image r8-question-image--one"></span><span class="r8-question-body"><ResearchMark kind="question" /><strong>{zh?"规模何时变成力量？":"When does scale become power?"}</strong><i aria-hidden="true">↗</i></span></a><a href={localizedPath(locale,"/topics/competition/")}><span class="r8-question-image r8-question-image--two"></span><span class="r8-question-body"><ResearchMark kind="question" /><strong>{zh?"谁仍然可以说“不”？":"Who can still say no?"}</strong><i aria-hidden="true">↗</i></span></a><a href={localizedPath(locale,"/concepts/competitive-constraint/")}><span class="r8-question-image r8-question-image--three"></span><span class="r8-question-body"><ResearchMark kind="question" /><strong>{zh?"当约束消失时，什么会变化？":"What changes when a constraint disappears?"}</strong><i aria-hidden="true">↗</i></span></a></div></section>
    {feature && (()=>{const item=getCaseDisplayData(feature,locale);return <section class="r8-case" aria-labelledby="case-heading"><a href={localizedPath(locale,`/cases/${feature.id}/`)}><figure><img src={feature.data.heroImage} alt={feature.data.heroImageAlt}/><figcaption>{zh?"案例 001 / 研究现场":"Case 001 / research field"}</figcaption></figure><div><p class="discovery-kicker">{zh?"地貌在这里被检验":"The terrain becomes testable here"}</p><span>{zh?"案例":"Case"} {feature.data.caseNumber??"001"}</span><h2 id="case-heading">{item.centralQuestion}</h2><small>{item.topics.join(" · ")}<br/>{item.concepts.join(" · ")}</small><em>{zh?"进入案例":"Enter case"} <i aria-hidden="true">↗</i></em></div></a></section>})()}
    <footer class="r8-closing"><p>{zh?"每一个答案，都会打开另一个问题。":"Every answer opens another question."}</p><nav aria-label={zh?"继续研究":"Continue research"}><a href={localizedPath(locale,"/topics/")}>{zh?"探索主题":"Explore Topics"}</a><a href={localizedPath(locale,"/concepts/")}>{zh?"浏览概念":"Browse Concepts"}</a><a href={localizedPath(locale,"/") + "#one-more-question"}>{zh?"另一个问题":"One More Question"}</a></nav></footer>
  </section>
</BaseLayout>
