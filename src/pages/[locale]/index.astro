---
import { getCollection } from "astro:content";
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/source-sans-3";
import FeaturedCaseHero from "../../components/home/FeaturedCaseHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCaseDisplayData, getTaxonomyItems, sortCasesByDate } from "../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../lib/siteCopy";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const publishedCases = sortCasesByDate(await getCollection("cases", ({ data }) => data.status === "published"));
const localizedCases = locale === "zh" ? publishedCases.filter((entry) => hasCaseLocale(locale, entry.id)) : publishedCases;
const researchCases = localizedCases.filter((entry) => entry.id !== "sample-foundation-case");
const featuredCase = researchCases.find((entry) => entry.data.featured) ?? researchCases[0];
const featuredDisplay = featuredCase ? getCaseDisplayData(featuredCase, locale) : null;
const concepts = getTaxonomyItems(researchCases, "concepts").slice(0, 4);
const featuredHref = featuredCase ? localizedPath(locale, `/cases/${featuredCase.id}/`) : localizedPath(locale, "/cases/");

const searchIndex = researchCases.map((entry) => {
  const display = getCaseDisplayData(entry, locale);
  return {
    title: display.title,
    summary: display.summary,
    centralQuestion: display.centralQuestion,
    url: localizedPath(locale, `/cases/${entry.id}/`),
    meta: [...display.entities, ...display.topics, ...display.concepts].slice(0, 4),
    searchableText: [display.title, display.summary, display.centralQuestion, ...display.entities, ...display.topics, ...display.concepts]
      .join(" ")
      .toLowerCase(),
  };
});

const home = locale === "zh"
  ? {
      caseLabel: "案例 001",
      heroHeadline: "便利之后",
      heroSummary: "世界上最便利的市场之后，隐藏着怎样的取舍？",
      exploreCase: "阅读案例",
      explore: "探索 Understory",
      question: "你的下一个问题是什么？",
      searchDescription: "在商业案例、核心概念和分析框架中寻找答案，或从一个问题开始新的探索。",
      searchPlaceholder: "搜索案例、概念与洞察",
      searchScope: "案例 / 概念 / 主题 / 洞察",
      brandTitle: "UNDERSTORY",
      brandDescription: "一个独立的商业研究档案，探索企业、市场与决策背后的隐藏结构。",
      brandPurpose: "我们沿着证据、取舍与激励继续追问，理解那些看得见的结果为何发生。",
      brandCategories: [
        { title: "案例", text: "以证据为基础，研究真实企业与关键决策。", href: "/cases/" },
        { title: "概念", text: "解释市场力量、竞争与消费者行为的核心机制。", href: "/concepts/" },
        { title: "框架", text: "把问题、背景、证据与判断连接起来的分析方法。", href: "/method/" },
      ],
      selected: "精选研究",
      archive: "进入研究档案",
      concepts: "商业概念",
      conceptsLead: "用可重复使用的分析视角，理解表面之下的机制。",
      method: "研究方法",
      methodLead: "一条从好奇心到有边界判断的路径。",
      methodSteps: [
        { title: "问题", text: "我们真正试图理解的是什么？" },
        { title: "背景", text: "这个决定发生在怎样的市场与竞争环境中？" },
        { title: "证据", text: "哪些事实能够支持、限制或改变分析？" },
        { title: "分析", text: "结构、激励与取舍如何共同作用？" },
        { title: "洞察", text: "现有证据允许我们得出怎样有边界的判断？" },
      ],
      readMethod: "了解我们的方法",
      footerLine: "一个独立的商业研究档案。",
      footerNote: "往下看。再问一个问题。",
    }
  : {
      caseLabel: "Case 001",
      heroHeadline: "Beyond Convenience",
      heroSummary: "The hidden trade-offs behind the world’s most convenient marketplace.",
      exploreCase: "Explore Case",
      explore: "Explore Understory",
      question: "What is your one more question?",
      searchDescription: "Search through business cases, core concepts, and analytical frameworks—or begin with a question of your own.",
      searchPlaceholder: "Search cases, concepts, and insights",
      searchScope: "Cases / Concepts / Topics / Insights",
      brandTitle: "UNDERSTORY",
      brandDescription: "An independent business research archive exploring the hidden structures behind companies, markets, and decisions.",
      brandPurpose: "We follow evidence, trade-offs, and incentives to understand why visible outcomes take shape.",
      brandCategories: [
        { title: "Cases", text: "Evidence-led investigations into real businesses and consequential decisions.", href: "/cases/" },
        { title: "Concepts", text: "Core mechanisms for understanding markets, competition, and behavior.", href: "/concepts/" },
        { title: "Frameworks", text: "Structured ways to connect questions, context, evidence, and judgement.", href: "/method/" },
      ],
      selected: "Selected Research",
      archive: "Enter the research archive",
      concepts: "Business Concepts",
      conceptsLead: "Reusable lenses for understanding the mechanisms beneath the surface.",
      method: "Method",
      methodLead: "A path from curiosity to a bounded, evidence-led judgement.",
      methodSteps: [
        { title: "Question", text: "What problem are we actually trying to understand?" },
        { title: "Context", text: "Where does this decision sit within its market and competitive environment?" },
        { title: "Evidence", text: "What facts support, limit, or could change the analysis?" },
        { title: "Analysis", text: "How do structures, incentives, and trade-offs interact?" },
        { title: "Insight", text: "What bounded judgement does the available evidence allow?" },
      ],
      readMethod: "Read our method",
      footerLine: "An independent business research archive.",
      footerNote: "Look beneath. Ask one more question.",
    };
---

<BaseLayout title={copy.brand.name} description={copy.brand.descriptor} locale={locale}>
  <div class="editorial-home">
    {
      featuredCase && (
        <FeaturedCaseHero
          href={featuredHref}
          company={featuredDisplay?.entities[0] ?? "Amazon"}
          eyebrow={home.caseLabel}
          headline={home.heroHeadline}
          summary={home.heroSummary}
          cta={home.exploreCase}
          image="/images/amazon-logistics-hero.png"
        />
      )
    }

    <section class="brand-introduction" aria-labelledby="brand-introduction-title">
      <div class="brand-introduction__identity">
        <p class="editorial-kicker">Independent research archive</p>
        <h1 id="brand-introduction-title">{home.brandTitle}</h1>
      </div>
      <div class="brand-introduction__definition">
        <p class="brand-introduction__description">{home.brandDescription}</p>
        <p class="brand-introduction__purpose">{home.brandPurpose}</p>
      </div>
      <nav class="brand-introduction__categories" aria-label={locale === "zh" ? "探索 Understory" : "Explore Understory"}>
        {home.brandCategories.map((category, index) => (
          <a href={localizedPath(locale, category.href)}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{category.title}</strong>
            <p>{category.text}</p>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </nav>
    </section>

    <section class="question-search" id="one-more-question" aria-labelledby="question-search-heading">
      <div class="question-search__heading">
        <p class="editorial-kicker">{home.explore}</p>
        <h2 id="question-search-heading">{home.question}</h2>
        <p>{home.searchDescription}</p>
      </div>
      <div class="question-search__tool" data-search-root data-search-idle={copy.search.idle} data-search-empty={copy.search.empty}>
        <label class="sr-only" for="editorial-search-input">{copy.search.label}</label>
        <div class="question-search__field">
          <span class="question-search__mark" aria-hidden="true"></span>
          <input id="editorial-search-input" type="search" placeholder={home.searchPlaceholder} autocomplete="off" data-search-input />
          <span aria-hidden="true">↵</span>
        </div>
        <div class="question-search__underbar">
          <span>{home.searchScope}</span>
          <span aria-live="polite" data-search-status>{copy.search.idle}</span>
        </div>
        <ol class="question-search__results" data-search-results></ol>
      </div>
    </section>

    <section class="research-preview" aria-labelledby="research-preview-title">
      <div class="section-masthead">
        <div><p class="editorial-kicker">Archive / 01</p><h2 id="research-preview-title">{home.selected}</h2></div>
        <a href={localizedPath(locale, "/cases/")}>{home.archive}<span aria-hidden="true">↗</span></a>
      </div>
      <ol class="research-list">
        {researchCases.map((entry, index) => {
          const display = getCaseDisplayData(entry, locale);
          return (
            <li>
              <a href={localizedPath(locale, `/cases/${entry.id}/`)}>
                <span class="research-list__number">{String(index + 1).padStart(2, "0")}</span>
                <span class="research-list__company">{display.entities[0]}</span>
                <span class="research-list__title">{entry.id === featuredCase?.id ? home.heroHeadline : display.title}</span>
                <span class="research-list__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="concepts-preview" aria-labelledby="concepts-preview-title">
      <div class="concepts-preview__intro">
        <p class="editorial-kicker">Index / 02</p>
        <h2 id="concepts-preview-title">{home.concepts}</h2>
        <p>{home.conceptsLead}</p>
      </div>
      <ol class="concept-index-home">
        {concepts.map((concept, index) => (
          <li><a href={localizedPath(locale, `/concepts/${concept.slug}/`)}><span>{String(index + 1).padStart(2, "0")}</span>{concept.name}<i aria-hidden="true">↗</i></a></li>
        ))}
      </ol>
    </section>

    <section class="method-preview-v2" aria-labelledby="method-preview-title">
      <div class="method-preview-v2__intro">
        <p class="editorial-kicker">Process / 03</p>
        <h2 id="method-preview-title">{home.method}</h2>
        <p>{home.methodLead}</p>
        <a href={localizedPath(locale, "/method/")}>{home.readMethod}<span aria-hidden="true">↗</span></a>
      </div>
      <ol class="method-path">
        {home.methodSteps.map((step, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><strong>{step.title}</strong><p>{step.text}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <footer class="editorial-footer">
      <div class="editorial-footer__brand"><img src="/brand/understory-symbol.svg" alt="" /><span>understory</span></div>
      <p>{home.footerLine}</p>
      <div class="editorial-footer__bottom"><span>{home.footerNote}</span><span>© {new Date().getFullYear()} Understory</span></div>
    </footer>
  </div>

  <script is:inline type="application/json" id="published-search-index" set:html={JSON.stringify(searchIndex)} />
  <script is:inline>
    // @ts-nocheck
    const searchRoot = document.querySelector("[data-search-root]");
    const input = searchRoot?.querySelector("[data-search-input]");
    const status = searchRoot?.querySelector("[data-search-status]");
    const results = searchRoot?.querySelector("[data-search-results]");
    const indexElement = document.getElementById("published-search-index");
    const data = indexElement?.textContent ? JSON.parse(indexElement.textContent) : [];
    const renderResults = (query) => {
      const normalized = query.trim().toLowerCase();
      results.innerHTML = "";
      if (normalized.length < 2) { status.textContent = searchRoot.dataset.searchIdle; return; }
      const matches = data.filter((item) => item.searchableText.includes(normalized)).slice(0, 5);
      status.textContent = matches.length ? `${matches.length} ${matches.length === 1 ? "result" : "results"}` : searchRoot.dataset.searchEmpty;
      matches.forEach((item) => {
        const li = document.createElement("li");
        const link = document.createElement("a");
        link.href = item.url;
        link.innerHTML = `<span>${item.title}</span><small>${item.meta.join(" · ")}</small>`;
        li.append(link); results.append(li);
      });
    };
    input?.addEventListener("input", (event) => renderResults(event.target.value));
  </script>
</BaseLayout>
