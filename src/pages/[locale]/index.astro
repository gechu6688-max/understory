---
import { getCollection } from "astro:content";
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/source-sans-3";
import FeaturedCaseHero from "../../components/home/FeaturedCaseHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCaseDisplayData, sortCasesByDate } from "../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../lib/siteCopy";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const publishedCases = sortCasesByDate(await getCollection("cases", ({ data }) => data.status === "published"));
const localizedCases = locale === "zh" ? publishedCases.filter((entry) => hasCaseLocale(locale, entry.id)) : publishedCases;
const researchCases = localizedCases.filter((entry) => entry.id !== "sample-foundation-case");
const featuredCase = researchCases.find((entry) => entry.data.featured) ?? researchCases[0];
const featuredHref = featuredCase ? localizedPath(locale, `/cases/${featuredCase.id}/`) : localizedPath(locale, "/cases/");

const searchIndex = researchCases.map((entry) => {
  const display = getCaseDisplayData(entry, locale);
  return {
    title: display.title,
    summary: display.summary,
    centralQuestion: display.centralQuestion,
    url: localizedPath(locale, `/cases/${entry.id}/`),
    meta: [...display.entities, ...display.topics, ...display.concepts].slice(0, 4),
    searchableText: [display.title, display.summary, display.centralQuestion, ...display.entities, ...display.topics, ...display.concepts]
      .join(" ")
      .toLowerCase(),
  };
});

const home = locale === "zh"
  ? {
      caseLabel: "案例 001",
      heroCompany: "Amazon / 亚马逊",
      heroHeadline: "在便利之外",
      heroSummary: "当世界变得更便利，\n我们仍需要追问：\n这背后发生了什么？",
      exploreCase: "阅读案例",
      panelTitle: "从观察到判断",
      panelItems: ["看见现象", "命名概念", "追溯机制", "在案例中应用"],
      searchPlaceholder: "搜索案例、概念与洞察",
      searchScope: "按案例 / 概念 / 问题 / 洞察探索",
      gateways: [
        { label: "案例", title: "真实的企业，\n更深的问题。", text: "从真实企业与市场出发，追问影响商业决策的关键问题。", action: "浏览案例", href: "/cases/", image: "/images/amazon-distribution-center.png" },
        { label: "概念", title: "用概念，\n看清问题的结构。", text: "理解市场、竞争与行为背后的关键机制。", action: "浏览概念", href: "/concepts/", image: "/images/amazon-locker-contested-convenience.png" },
        { label: "方法", title: "从问题出发，\n走向有边界的判断。", text: "连接情境、证据、机制与判断的一套研究路径。", action: "了解研究方法", href: "/method/", image: "/images/amazon-prime-last-mile.png" },
      ],
      methodLabel: "研究方法",
      methodPath: "问题 → 证据 → 机制 → 判断 → 再问一个问题",
      methodAction: "了解研究方法",
      footerLine: "一个独立的商业研究档案。",
      footerNote: "看见表面之下，\n再多问一个问题。",
      footerBrand: "Understory 问溯",
      footerNav: ["案例", "主题", "概念", "方法", "关于"],
    }
  : {
      caseLabel: "Case 001",
      heroCompany: "Amazon",
      heroHeadline: "Beyond Convenience",
      heroSummary: "The hidden trade-offs behind the world’s most convenient marketplace.",
      exploreCase: "Explore Case",
      panelTitle: "From observation to judgment",
      panelItems: ["See it", "Name it", "Trace the mechanism", "Apply it"],
      searchPlaceholder: "Search cases, concepts, and insights",
      searchScope: "Explore by case / concept / question / insight",
      gateways: [
        { label: "Cases", title: "Real businesses.\nDeeper questions.", text: "In-depth investigations into real companies, markets, and the decisions that shape them.", action: "Explore cases", href: "/cases/", image: "/images/amazon-distribution-center.png" },
        { label: "Concepts", title: "Lenses for\nsharper analysis.", text: "Core mechanisms for understanding markets, competition, and behaviour.", action: "Explore concepts", href: "/concepts/", image: "/images/amazon-locker-contested-convenience.png" },
        { label: "Method", title: "A path from\nquestion to judgment.", text: "A structured way to connect context, evidence, mechanisms, and judgment.", action: "Explore our method", href: "/method/", image: "/images/amazon-prime-last-mile.png" },
      ],
      methodLabel: "Method",
      methodPath: "Question → Evidence → Mechanism → Judgment → Another Question",
      methodAction: "Explore our method",
      footerLine: "An independent business research archive.",
      footerNote: "Look beneath.\nAsk one more question.",
      footerBrand: "Understory",
      footerNav: ["Archive", "Topics", "Concepts", "Method", "About"],
    };
---

<BaseLayout title={copy.brand.name} description={copy.brand.descriptor} locale={locale}>
  <div class="editorial-home">
    {
      featuredCase && (
        <FeaturedCaseHero
          href={featuredHref}
          company={home.heroCompany}
          eyebrow={home.caseLabel}
          headline={home.heroHeadline}
          summary={home.heroSummary}
          cta={home.exploreCase}
          image="/images/amazon-logistics-hero.png"
          locale={locale}
          panelTitle={home.panelTitle}
          panelItems={home.panelItems}
        />
      )
    }

    <section class="hero-search" id="one-more-question" aria-label={copy.search.label}>
      <div class="question-search__tool" data-search-root data-search-idle={copy.search.idle} data-search-empty={copy.search.empty}>
        <label class="sr-only" for="editorial-search-input">{copy.search.label}</label>
        <form class="question-search__field" data-search-form>
          <span class="question-search__mark" aria-hidden="true"></span>
          <input id="editorial-search-input" type="search" placeholder={home.searchPlaceholder} autocomplete="off" data-search-input />
          <button type="submit" aria-label={locale === "zh" ? "提交搜索" : "Submit search"}>→</button>
        </form>
        <div class="question-search__underbar">
          <span>{home.searchScope}</span>
          <span aria-live="polite" data-search-status>{copy.search.idle}</span>
        </div>
        <ol class="question-search__results" data-search-results></ol>
      </div>
    </section>

    <section class="home-gateways" aria-label={locale === "zh" ? "主要入口" : "Primary paths"}>
      {home.gateways.map((gateway, index) => (
        <a class="home-gateway" href={localizedPath(locale, gateway.href)}>
          <span class="home-gateway__number">{String(index + 1).padStart(2, "0")}</span>
          <span class="home-gateway__label">{gateway.label}</span>
          <h2>{gateway.title}</h2>
          <p>{gateway.text}</p>
          <img src={gateway.image} alt="" loading="lazy" />
          <span class="home-gateway__action">{gateway.action}<b aria-hidden="true">→</b></span>
        </a>
      ))}
    </section>

    <section class="home-method-strip" aria-label={home.methodLabel}>
      <span>{home.methodLabel}</span>
      <p>{home.methodPath}</p>
      <a href={localizedPath(locale, "/method/")}>{home.methodAction} <b aria-hidden="true">→</b></a>
    </section>

    <footer class="editorial-footer">
      <div class="editorial-footer__main">
        <div><div class="editorial-footer__brand"><img src="/brand/understory-symbol.svg" alt="" /><span>{home.footerBrand}</span></div><p data-cms-global="footerLine">{home.footerLine}</p></div>
        <p class="editorial-footer__note" data-cms-global="footerNote">{home.footerNote}</p>
      </div>
      <div class="editorial-footer__bottom"><span>© {new Date().getFullYear()} Understory</span><nav aria-label={locale === "zh" ? "页脚导航" : "Footer navigation"}>{copy.nav.map((item, index) => <a href={localizedPath(locale, item.href)}>{home.footerNav[index] ?? item.label}</a>)}</nav></div>
    </footer>
  </div>

  <script is:inline type="application/json" id="published-search-index" set:html={JSON.stringify(searchIndex)} />
  <script is:inline>
    // @ts-nocheck
    const searchRoot = document.querySelector("[data-search-root]");
    const input = searchRoot?.querySelector("[data-search-input]");
    const form = searchRoot?.querySelector("[data-search-form]");
    const status = searchRoot?.querySelector("[data-search-status]");
    const results = searchRoot?.querySelector("[data-search-results]");
    const indexElement = document.getElementById("published-search-index");
    const data = indexElement?.textContent ? JSON.parse(indexElement.textContent) : [];
    const renderResults = (query) => {
      const normalized = query.trim().toLowerCase();
      results.innerHTML = "";
      if (normalized.length < 2) { status.textContent = searchRoot.dataset.searchIdle; return; }
      const matches = data.filter((item) => item.searchableText.includes(normalized)).slice(0, 5);
      status.textContent = matches.length ? `${matches.length} ${matches.length === 1 ? "result" : "results"}` : searchRoot.dataset.searchEmpty;
      matches.forEach((item) => {
        const li = document.createElement("li");
        const link = document.createElement("a");
        link.href = item.url;
        link.innerHTML = `<span>${item.title}</span><small>${item.meta.join(" · ")}</small>`;
        li.append(link); results.append(li);
      });
    };
    const getMatches = (query) => data.filter((item) => item.searchableText.includes(query.trim().toLowerCase())).slice(0, 5);
    input?.addEventListener("input", (event) => renderResults(event.target.value));
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const matches = getMatches(input.value);
      if (matches[0]) window.location.assign(matches[0].url);
      else renderResults(input.value);
    });
  </script>
</BaseLayout>
