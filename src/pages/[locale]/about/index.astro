---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isLocale, locales, localizedPath } from "../../../lib/siteCopy";

export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const zh = locale === "zh";
const heroLines = zh ? ["每一个看似", "清楚的答案背后，", "都还有一个值得", "继续问下去的问题。"] : ["Behind every", "obvious answer", "is another question", "worth asking."];
const copy = zh ? {
  hero: "每一个看似清楚的答案背后，都还有一个值得继续问下去的问题。", heroSupport: "问溯是一个独立项目，从商业表面之下寻找问题。",
  why: "为什么会有问溯", whyText: "商业世界总是很快给出解释。问溯想把这些解释放慢一点，再往下看。", surface: "表面", under: "表面之下", surfaceWords: ["增长", "价格", "便利", "竞争", "市场份额"], fields: ["激励", "力量", "行为", "取舍", "制度", "后果"],
  question: "再问一个问题", questions: [["一家公司在增长。", "为什么？"], ["消费者选择便利。", "代价是什么？"], ["一个市场日渐集中。", "这对谁重要？"], ["一个解释看起来很有说服力。", "它可能遗漏了什么？"]], answer: "每一个答案，都会改变下一个问题。",
  principles: "我们的原则", principleList: [["看见结果之下", "不只问发生了什么，也问是什么造成了它。"], ["把证据和解释分开", "我们观察到的，不总等于它意味着什么。"], ["让不确定仍然可见", "好的分析不会抹去仍然未知的部分。"], ["给下一个问题留位置", "判断可以结束论证，却不必结束好奇。"]],
  not: "这不是什么", notList: [["不是新闻流。", "速度不等于理解。"], ["不是教科书。", "概念只在解释真实事物时才重要。"], ["不是商业经验的集合。", "案例从问题开始，而不是从寓意开始。"], ["不是最终结论。", "每一个判断都有边界。"]],
  archive: "一座正在生长的档案", archiveText: "问溯通过联系而不是分类生长。案例、概念与主题相互影响；每一个答案，都会打开另一个问题。", archiveLink: "探索档案", relations: [["案例", "可以显出一种机制"], ["机制", "可以重新塑造一个主题"], ["主题", "可以通向另一个问题"]], archiveEnd: "这里没有任何东西，应该独自站立。",
  creator: "创作与编辑", creatorName: "Sherry Ge / 葛梓暄", creatorText: "一位从经济学、心理学，以及它们之间不断浮现的问题出发，探索商业的学生。\n\n问溯开始于一个愿望：不再只收集答案，而开始建立更好的问题。",
  finalTitle: "这座档案，因未完成而存在。", finalMeta: "UNDERSTORY / 问溯", finalDetails: "独立商业探究\n杭州 · 2026—\n由 Sherry Ge 创作与编辑", finalLink: "带着一个问题继续 →",
  alts: { hero: "傍晚城市商业区和交通基础设施的真实摄影。", observer: "站在城市商业环境中进行观察的人。", creator: "带有窗景与研究痕迹的真实工作环境。", final: "黄昏中的城市商业景观。" }
} : {
  hero: "Behind every obvious answer is another question worth asking.", heroSupport: "Understory is an independent project for looking beneath the surface of business.",
  why: "Why Understory", whyText: "Business stories are often explained before we have had time to look at them. Understory slows those explanations down and looks underneath.", surface: "The surface", under: "Under the surface", surfaceWords: ["Growth", "Price", "Convenience", "Competition", "Market share"], fields: ["Incentives", "Power", "Behaviour", "Trade-offs", "Institutions", "Consequences"],
  question: "One More Question", questions: [["A company grows.", "Why?"], ["Consumers choose convenience.", "At what cost?"], ["A market becomes concentrated.", "For whom does that matter?"], ["An explanation seems convincing.", "What might it be missing?"]], answer: "Every answer changes the next question.",
  principles: "Our Principles", principleList: [["Look beneath outcomes", "Not only what happened, but what produced it."], ["Separate evidence from interpretation", "What we observe is not always what it means."], ["Keep uncertainty visible", "Good analysis does not erase what remains unknown."], ["Leave room for another question", "Judgment can close an argument without closing curiosity."]],
  not: "What This Is Not", notList: [["Not a news feed.", "Speed is not the same as understanding."], ["Not a textbook.", "Concepts matter when they explain something real."], ["Not a collection of business lessons.", "Cases begin with questions, not morals."], ["Not the final word.", "Every judgment has a boundary."]],
  archive: "A Living Archive", archiveText: "Understory grows through connections, not categories. Cases, concepts and topics inform each other, and each answer opens another question.", archiveLink: "Explore the archive", relations: [["Case", "can expose a mechanism"], ["Mechanism", "can reshape a topic"], ["Topic", "can lead toward another question"]], archiveEnd: "Nothing here is meant to stand alone.",
  creator: "Created & Edited by", creatorName: "Sherry Ge / 葛梓暄", creatorText: "A student exploring business through economics, psychology and the questions that emerge between them.\n\nUnderstory began as a way to move beyond collecting answers — and start building better questions.",
  finalTitle: "The archive is unfinished by design.", finalMeta: "UNDERSTORY / 问溯", finalDetails: "Independent business inquiry\nHangzhou · 2026—\nCreated and edited by Sherry Ge", finalLink: "Continue with a question →",
  alts: { hero: "A real photograph of urban commercial infrastructure and movement at dusk.", observer: "A person observing a city commercial environment.", creator: "A real working research environment with a city view.", final: "A cinematic dusk view of a commercial city landscape." }
};

const images = {
  hero: "https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?auto=format&fit=crop&w=1800&q=88",
  observer: "https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=1200&q=85",
  creator: "https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1300&q=85",
  final: "https://images.unsplash.com/photo-1444723121867-7a241cacace9?auto=format&fit=crop&w=2000&q=88",
  strip: ["photo-1486406146926-c627a92ad1ab", "photo-1555529771-835f59fc5efe", "photo-1449824913935-59a10b8d2000", "photo-1497366216548-37526070297c", "photo-1465447142348-e9952c393450", "photo-1519501025264-65ba15a82390"].map((id) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=750&q=82`)
};
---

<BaseLayout title={zh ? "关于问溯" : "About Understory"} description={zh ? "问溯：一份独立商业探究的编辑说明。" : "Understory: an independent business inquiry."} locale={locale}>
  <article class="about82" aria-labelledby="about-heading">
    <header class="about82-hero">
      <div class="about82-hero__copy"><p class="about82-label">{zh ? "关于" : "About"}</p><span>01</span><h1 id="about-heading">{heroLines.map((line) => <span>{line}</span>)}</h1><p>{copy.heroSupport}</p></div>
      <figure><img src={images.hero} alt={copy.alts.hero} /><figcaption>{zh ? "城市系统 / 黄昏" : "Urban systems / dusk"}</figcaption></figure>
    </header>

    <section class="about82-why" aria-labelledby="why-heading">
      <header><span>02</span><h2 id="why-heading">{copy.why}</h2><p>{copy.whyText}</p></header>
      <div class="about82-why__surface"><p class="about82-label">{copy.surface}</p><div>{copy.surfaceWords.map((word) => <span>{word}</span>)}</div></div>
      <div class="about82-why__under"><p class="about82-label">{copy.under}</p><div class="about82-strip">{copy.fields.map((field, index) => <figure><img src={images.strip[index]} alt="" /><figcaption>{field}</figcaption></figure>)}</div></div>
    </section>

    <section class="about82-question" aria-labelledby="question-heading">
      <figure><img src={images.observer} alt={copy.alts.observer} /></figure>
      <header><span>03</span><h2 id="question-heading">{copy.question}</h2></header>
      <ol>{copy.questions.map(([line, question]) => <li><span>{line}</span><strong>{question}</strong></li>)}</ol>
      <aside><p>{copy.answer}</p><span>{zh ? "再问一个问题" : "One More Question"}</span></aside>
    </section>

    <section class="about82-principles" aria-labelledby="principles-heading">
      <header><span>04</span><h2 id="principles-heading">{copy.principles}</h2></header>
      <ol>{copy.principleList.map(([title, detail], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{detail}</p></li>)}</ol>
    </section>

    <section class="about82-not" aria-labelledby="not-heading">
      <header><span>05</span><h2 id="not-heading">{copy.not}</h2></header>
      <ol>{copy.notList.map(([title, detail]) => <li><h3>{title}</h3><p>{detail}</p></li>)}</ol>
    </section>

    <section class="about82-archive" aria-labelledby="archive-heading">
      <header><span>06</span><h2 id="archive-heading">{copy.archive}</h2></header>
      <div class="about82-archive__copy"><p>{copy.archiveText}</p><a href={localizedPath(locale, "/cases/")}>{copy.archiveLink} <i aria-hidden="true">→</i></a></div>
      <div class="about82-archive__relations">{copy.relations.map(([term, detail], index) => <><div><strong>{term}</strong><span>{detail}</span></div>{index < copy.relations.length - 1 && <i aria-hidden="true">→</i>}</>)}</div>
      <p class="about82-archive__end">{copy.archiveEnd}</p>
    </section>

    <section class="about82-creator" aria-labelledby="creator-heading">
      <header><span>07</span><h2 id="creator-heading">{copy.creator}</h2></header>
      <div><h3>{copy.creatorName}</h3>{copy.creatorText.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}</div>
      <figure><img src={images.creator} alt={copy.alts.creator} /><figcaption>{zh ? "工作中的研究 / 窗景" : "Research in context / window view"}</figcaption></figure>
    </section>

    <footer class="about82-colophon">
      <img src={images.final} alt={copy.alts.final} />
      <div class="about82-colophon__meta"><strong>{copy.finalMeta}</strong><p>{copy.finalDetails}</p></div>
      <h2>{copy.finalTitle}</h2>
      <a href={localizedPath(locale, "/")}>{copy.finalLink}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .about82 { --about-display: Georgia, "Iowan Old Style", "Palatino Linotype", "Book Antiqua", serif; color: #18201c; }.about82 :global(h1),.about82 :global(h2),.about82 :global(h3),.about82 :global(p),.about82 :global(ol),.about82 :global(figure){margin-top:0}.about82-label,.about82 header>span,.about82-principles li>span{color:var(--color-bronze);font-size:.64rem;font-weight:730;letter-spacing:.14em;text-transform:uppercase}.about82 h1,.about82 h2,.about82-question aside p,.about82-colophon h2{font-family:var(--about-display);font-weight:400;letter-spacing:-.018em}.about82 figure{margin-bottom:0}.about82 img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.78) contrast(1.04)}
  .about82-hero{display:grid;grid-template-columns:37% 63%;min-height:clamp(39rem,58vw,53rem);margin-top:clamp(1rem,3vw,3rem)}.about82-hero__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(2rem,5vw,5.5rem) clamp(1.4rem,4.5vw,5rem) clamp(2rem,5vw,4.5rem) 0}.about82-hero__copy>span{margin:clamp(3rem,8vw,8rem) 0 .8rem;color:var(--color-bronze);font-size:.67rem;font-weight:700}.about82-hero h1{margin-bottom:1.6rem;font-size:clamp(3.1rem,3.7vw,4.25rem);line-height:.94}.about82-hero h1 span{display:block;white-space:nowrap}.about82-hero__copy>p:last-child{max-width:23rem;color:var(--color-text-secondary);font-size:1.02rem;line-height:1.55}.about82-hero figure{position:relative;min-height:100%;overflow:hidden}.about82-hero figcaption{position:absolute;right:1.2rem;bottom:1rem;color:#f7f4ee;font-size:.62rem;font-weight:650;letter-spacing:.1em;text-transform:uppercase}
  .about82-why{display:grid;grid-template-columns:23% 77%;gap:0;padding:clamp(6rem,11vw,11rem) 0}.about82-why>header{padding-right:clamp(1.5rem,4vw,4rem)}.about82-why h2,.about82-principles h2,.about82-not h2,.about82-archive h2,.about82-creator h2{max-width:6ch;margin:.65rem 0 1.3rem;font-size:clamp(2.8rem,4.4vw,5rem);line-height:.94}.about82-why header>p{max-width:15rem;color:var(--color-text-secondary);font-size:.9rem;line-height:1.55}.about82-why__surface{align-self:end}.about82-why__surface>div{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;font-family:var(--about-display);font-size:clamp(1.55rem,2.8vw,3.1rem);line-height:1.06}.about82-why__under{grid-column:2;margin-top:clamp(3rem,6vw,6rem)}.about82-strip{display:grid;grid-template-columns:repeat(6,1fr);height:clamp(11rem,17vw,16rem);margin-top:.8rem;overflow:hidden}.about82-strip figure{position:relative;overflow:hidden}.about82-strip figure:nth-child(2) img{object-position:58% center}.about82-strip figure:nth-child(3) img{object-position:65% center}.about82-strip figure:nth-child(4) img{object-position:35% center}.about82-strip figure:nth-child(5) img{object-position:55% center}.about82-strip figcaption{position:absolute;left:.8rem;bottom:.75rem;color:#fffdf8;font-family:var(--about-display);font-size:clamp(1.1rem,1.8vw,1.8rem);line-height:1.06;text-shadow:0 1px 12px rgba(0,0,0,.55)}
  .about82-question{display:grid;grid-template-columns:39% 15% 24% 22%;min-height:clamp(29rem,41vw,40rem);background:#e6e1d6}.about82-question>figure{overflow:hidden}.about82-question>figure img{object-position:center}.about82-question>header{padding:clamp(1.5rem,3vw,3rem) 1rem}.about82-question h2{margin:.7rem 0;font-size:clamp(2.7rem,4vw,4.6rem);line-height:.85}.about82-question ol{align-self:center;margin:0;padding:clamp(1.5rem,3vw,3rem) 1rem;list-style:none}.about82-question li{padding:.7rem 0;color:var(--color-text-secondary);font-size:.82rem;line-height:1.35}.about82-question li+li{border-top:1px solid rgba(24,32,28,.15)}.about82-question li span,.about82-question li strong{display:block}.about82-question li strong{margin-top:.15rem;color:var(--color-text);font-size:.92rem}.about82-question aside{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.5rem,3vw,3rem) clamp(1rem,3vw,3rem);background:#d2a954}.about82-question aside p{max-width:8ch;margin-bottom:2rem;font-size:clamp(2.1rem,3.5vw,3.8rem);line-height:.9}.about82-question aside span{font-size:.62rem;font-weight:720;letter-spacing:.12em;text-transform:uppercase}
  .about82-principles{display:grid;grid-template-columns:23% 77%;padding:clamp(5rem,9vw,9rem) 0}.about82-principles>header{padding-right:1rem}.about82-principles ol{display:grid;grid-template-columns:repeat(4,1fr);margin:0;padding:0;list-style:none}.about82-principles li{padding:0 clamp(.8rem,2vw,2rem);min-height:13rem}.about82-principles li+li{border-left:1px solid var(--color-border)}.about82-principles h3{margin:2.5rem 0 .75rem;font-size:1.05rem;line-height:1.22}.about82-principles p{margin-bottom:0;color:var(--color-text-secondary);font-size:.86rem;line-height:1.5}
  .about82-not{display:grid;grid-template-columns:23% 77%;padding:clamp(5rem,9vw,9rem) clamp(1.25rem,4vw,3.5rem);margin-inline:calc(-1 * clamp(1.25rem,4vw,3.5rem));background:var(--color-accent-dark);color:#f7f2e8}.about82-not header>span{color:#d5b478}.about82-not h2{max-width:5ch}.about82-not ol{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(1rem,3vw,3rem);margin:0;padding:0;list-style:none;align-self:center}.about82-not h3{margin-bottom:.75rem;font-family:var(--about-display);font-size:clamp(1.5rem,2.2vw,2.3rem);font-weight:400;line-height:1.03}.about82-not p{max-width:16ch;margin-bottom:0;color:#c4d0c5;font-size:.86rem;line-height:1.5}
  .about82-archive{display:grid;grid-template-columns:23% 30% 47%;padding:clamp(6rem,11vw,11rem) 0}.about82-archive__copy{padding-right:2rem}.about82-archive__copy>p{color:var(--color-text-secondary);line-height:1.62}.about82-archive__copy a{display:inline-block;margin-top:1.6rem;color:var(--color-accent);font-size:.68rem;font-weight:750;letter-spacing:.1em;text-transform:uppercase}.about82-archive__copy i{color:var(--color-bronze);font-style:normal}.about82-archive__relations{display:flex;align-items:center;justify-content:space-between;gap:clamp(.5rem,2vw,2rem);padding-top:2rem}.about82-archive__relations div{display:flex;flex-direction:column;gap:.65rem;max-width:10rem}.about82-archive__relations strong{font-family:var(--about-display);font-size:clamp(1.6rem,2.7vw,3rem);font-weight:400;line-height:1}.about82-archive__relations span{color:var(--color-text-secondary);font-size:.78rem;line-height:1.35}.about82-archive__relations>i{color:var(--color-bronze);font-style:normal}.about82-archive__end{grid-column:2 / -1;margin:clamp(4rem,8vw,8rem) 0 0;font-family:var(--about-display);font-size:clamp(2rem,3.5vw,3.8rem);line-height:1}
  .about82-creator{display:grid;grid-template-columns:23% 34% 43%;min-height:clamp(31rem,41vw,40rem);background:#e6e1d6}.about82-creator>header,.about82-creator>div{padding:clamp(2rem,5vw,5rem) clamp(1.2rem,3vw,3rem)}.about82-creator h2{max-width:5ch}.about82-creator h3{margin:0 0 2rem;font-size:1.08rem}.about82-creator p{white-space:pre-line;color:var(--color-text-secondary);font-size:.96rem;line-height:1.65}.about82-creator>figure{position:relative;overflow:hidden}.about82-creator figcaption{position:absolute;right:1rem;bottom:1rem;color:#f7f2e8;font-size:.61rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .about82-colophon{position:relative;display:grid;grid-template-columns:28% 47% 25%;align-items:end;min-height:clamp(34rem,52vw,53rem);margin:clamp(4rem,9vw,9rem) calc(-1 * clamp(1.25rem,4vw,3.5rem)) 0;padding:clamp(1.5rem,4vw,4rem);overflow:hidden;color:#f8f2e9}.about82-colophon::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(6,19,15,.75),rgba(6,19,15,.18) 58%,rgba(6,19,15,.62));z-index:0}.about82-colophon>img,.about82-colophon>div,.about82-colophon>h2,.about82-colophon>a{position:relative;z-index:1}.about82-colophon>img{position:absolute;inset:0;z-index:0}.about82-colophon__meta strong{font-size:.7rem;letter-spacing:.11em}.about82-colophon__meta p{margin:.9rem 0 0;white-space:pre-line;font-size:.78rem;line-height:1.55}.about82-colophon h2{max-width:10ch;margin:0;font-size:clamp(3.2rem,6vw,7rem);line-height:.83}.about82-colophon>a{align-self:center;justify-self:end;color:#f8f2e9;font-size:.72rem;font-weight:720;letter-spacing:.08em;text-transform:uppercase}
  @media(max-width:780px){.about82-hero{grid-template-columns:1fr;min-height:0;margin-top:0}.about82-hero__copy{padding:3rem 0}.about82-hero__copy>span{margin:3rem 0 .8rem}.about82-hero h1{font-size:clamp(2.9rem,11.2vw,4.1rem)}.about82-hero h1 span{white-space:normal}.about82-hero figure{height:29rem}.about82-why,.about82-principles,.about82-not,.about82-archive,.about82-creator{grid-template-columns:minmax(0,1fr);gap:2rem}.about82-why{padding-block:5rem}.about82-why h2,.about82-principles h2,.about82-not h2,.about82-archive h2,.about82-creator h2{max-width:10ch;font-size:clamp(2.7rem,10vw,4.2rem)}.about82-why>header,.about82-why__surface,.about82-why__under{min-width:0}.about82-why__surface{grid-column:auto}.about82-why__surface>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.about82-why__under{grid-column:auto;margin-top:2rem}.about82-strip{width:100%;max-width:100%;height:13rem;overflow-x:auto;grid-template-columns:repeat(6,8rem)}.about82-question{grid-template-columns:1fr;min-height:0}.about82-question>figure{height:22rem}.about82-question>header{display:grid;grid-template-columns:3rem minmax(0,1fr);align-items:start}.about82-question h2{margin:0;font-size:clamp(3rem,12vw,4.8rem)}.about82-question ol{padding-top:0}.about82-question aside{min-height:16rem}.about82-principles{padding-block:5rem}.about82-principles ol{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.2rem}.about82-principles li{min-height:0;padding:0}.about82-principles li+li{border-left:0}.about82-principles h3{margin-top:1.3rem}.about82-not{margin-inline:calc(-1 * 1.25rem);padding:4rem 1.25rem}.about82-not ol{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem 1.3rem}.about82-archive{padding-block:5rem}.about82-archive__relations{padding-top:1rem}.about82-archive__relations{flex-wrap:wrap}.about82-archive__relations div{width:calc(50% - 1rem)}.about82-archive__relations>i{display:none}.about82-archive__end{grid-column:auto;margin-top:3rem}.about82-creator{margin-inline:calc(-1 * 1.25rem)}.about82-creator>header,.about82-creator>div{padding:2.5rem 1.25rem}.about82-creator>figure{height:24rem}.about82-colophon{grid-template-columns:1fr;align-items:start;gap:3rem;min-height:39rem;margin:4rem -1.25rem 0;padding:2rem 1.25rem}.about82-colophon h2{font-size:clamp(3.2rem,13vw,5.2rem)}.about82-colophon>a{justify-self:start;align-self:end}.about82-colophon__meta{order:2}.about82-colophon h2{order:1}.about82-colophon>a{order:3}}
  :global(html:lang(zh-CN)) .about82 h1,:global(html:lang(zh-CN)) .about82 h2,:global(html:lang(zh-CN)) .about82-question aside p,:global(html:lang(zh-CN)) .about82-colophon h2,:global(html:lang(zh-CN)) .about82-why__surface>div,:global(html:lang(zh-CN)) .about82-strip figcaption,:global(html:lang(zh-CN)) .about82-archive__relations strong,:global(html:lang(zh-CN)) .about82-archive__end{font-family:var(--font-zh-display)}
