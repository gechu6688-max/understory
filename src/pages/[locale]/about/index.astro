---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isLocale, locales, localizedPath } from "../../../lib/siteCopy";

export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const zh = locale === "zh";
const copy = zh ? {
  title: "问题背后，还有什么？", eyebrow: "关于问溯 / Editorial note", intro: "结论最容易出现的地方，往往不是故事结束的地方。", introNote: "沿着决定、市场与系统向下看；再多问一个问题。",
  why: "为什么会有问溯", whyLead: "许多商业故事，抵达我们面前时已经被解释完了。", whyBody: "增长被归因于创新，失败被归因于竞争，价格被归因于供需。问溯想在这些快速的解释下面，停留得久一点。", beneath: "在那个解释之下，还有什么？",
  surfaces: [["便利", "谁承担了它的成本？"], ["竞争", "谁仍然有留下的空间？"], ["增长", "什么必须先在底层改变？"]],
  study: "我们看什么", studyLead: "不是把世界切成主题，而是从同一个故事里辨认不同的尺度。", scales: [["决定", "一个人、一家公司或一个平台，做了什么选择。"], ["机制", "为什么这个选择会产生这样的结果。"], ["系统", "哪些更大的结构，让某些选择变得容易，另一些变得困难。"]], amazon: "当日达，是表面可见的决定；物流密度、劳动力、Prime 会员制与平台力量，则在它的下方。",
  declaration: "问溯是什么，又不是什么", is: "问溯是", isnt: "问溯不是", isList: ["以研究为起点", "由问题驱动", "关心机制", "愿意和不确定共处", "可以被新证据修正"], isntList: ["热点观点的集合", "商业新闻的摘要", "预先写好结论的资料库", "把每个问题都装作确定的尝试"], declarationLine: "好的结论，应该结束一段论证，而不该结束一个问题。",
  editor: "写在后面的人", editorName: "Sherry Ge / 葛梓暄", editorRole: "创始人兼编辑", editorBody: "我开始做问溯，是因为我不断遇见一些太早就显得完整的解释。我想把商业、经济与人的选择放回更长一点的视野里：看证据，也看取舍；给判断，也给尚未知道的事留位置。", editorCaption: "研究不是把桌面收得很干净；而是知道哪一页还值得翻回去。",
  growth: "一份刊物如何生长", growthLead: "这里没有一条把问题带往终点的步骤。内容会在彼此之间反复回到起点。", path: ["问题", "案例", "概念 / 主题", "新的问题"], pathNote: "一个问题成为案例。反复出现的解释，慢慢形成概念；相互关联的压力，逐渐显出主题。每一个暂时的结论，都会带来下一次追问。",
  unfinished: "仍未完成", unfinishedLead: "问溯不是一座装满完成答案的档案馆。", unfinishedText: "它记录的是：问题如何慢慢变得更准确。下一道问题，已经在形成。", exits: [["进入一个案例", "/cases/"], ["走进一个主题", "/topics/"], ["沿着一个概念", "/concepts/"]], heroAlt: "街道与建筑之间的行人，作为观察商业系统的真实场景。", deskAlt: "打开的书页、笔记与研究桌面的近景。", printAlt: "置于阅读空间中的印刷物细节。"
} : {
  title: "Behind the questions.", eyebrow: "About / Editorial note", intro: "The obvious answer is rarely where the story ends.", introNote: "We look beneath decisions, markets, and systems — then ask one more question.",
  why: "Why Understory exists", whyLead: "Most business stories arrive already explained.", whyBody: "Growth is credited to innovation. Failure is blamed on competition. Price is reduced to supply and demand. Understory stays a little longer beneath those quick explanations.", beneath: "What sits underneath that explanation?", surfaces: [["Convenience", "Who absorbs the cost?"], ["Competition", "Who still has room to remain?"], ["Growth", "What had to change underneath?"]],
  study: "What we study", studyLead: "Not a smaller version of the topic index — a way to notice different scales inside the same story.", scales: [["Decision", "What a person, company, or platform chooses to do."], ["Mechanism", "Why that choice creates a particular result."], ["System", "Which larger structures make some choices easier and others harder."]], amazon: "Same-day delivery is a decision visible at the surface. Logistics density, labour, Prime membership, and marketplace power sit underneath it.",
  declaration: "What Understory is — and is not", is: "Understory is", isnt: "It is not", isList: ["research-led", "question-driven", "mechanism-oriented", "comfortable with uncertainty", "open to revision"], isntList: ["a collection of hot takes", "a business-news summary", "a library of predetermined conclusions", "an attempt to make every question look certain"], declarationLine: "A strong conclusion should close an argument, not close the question.",
  editor: "Who is behind it", editorName: "Sherry Ge / 葛梓暄", editorRole: "Founder & Editor", editorBody: "I started Understory because I kept encountering explanations that felt complete too early. I want to place business, economics, and human choices in a slightly longer view: to look at evidence and trade-offs, to make a judgement, and to leave room for what is still unknown.", editorCaption: "Research is not a desk made perfectly tidy; it is knowing which page is worth returning to.",
  growth: "How the publication grows", growthLead: "There is no sequence here that carries a question toward a finish. The work keeps returning to its beginning.", path: ["Question", "Case", "Concept / Topic", "New question"], pathNote: "A question becomes a case. A recurring explanation becomes a concept; related pressures begin to form a topic. Each provisional conclusion makes room for another question.",
  unfinished: "Still unfinished", unfinishedLead: "Understory is not an archive of finished answers.", unfinishedText: "It is a record of questions becoming more precise. The next one is already forming.", exits: [["Explore a Case", "/cases/"], ["Enter a Topic", "/topics/"], ["Follow a Concept", "/concepts/"]], heroAlt: "People moving through a city street, an editorial context for observing business systems.", deskAlt: "An open book, notes, and a close view of a research desk.", printAlt: "A printed page in a quiet reading environment."
};
const heroImage = "https://images.unsplash.com/photo-1449824913935-59a10b8d2000?auto=format&fit=crop&w=1600&q=85";
const deskImage = "https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=1400&q=85";
const printImage = "https://images.unsplash.com/photo-1456324504439-367cee3b3c32?auto=format&fit=crop&w=1200&q=85";
---

<BaseLayout title={zh ? "关于问溯" : "About Understory"} description={zh ? "问溯的编辑说明：在答案之下，再问一个问题。" : "An editorial note on why Understory asks what sits beneath the obvious answer."} locale={locale}>
  <article class="about-r8" aria-labelledby="about-heading">
    <header class="about-r8__opening"><div class="about-r8__opening-copy"><p class="about-r8__kicker">{copy.eyebrow}</p><h1 id="about-heading">{copy.title}</h1><p class="about-r8__intro">{copy.intro}</p><p class="about-r8__intro-note">{copy.introNote}</p></div><figure class="about-r8__hero-image"><img src={heroImage} alt={copy.heroAlt} /><figcaption><span>01 / {zh ? "现场" : "Field note"}</span><span>{zh ? "从可见之处开始" : "Begin with what is visible"}</span></figcaption></figure></header>
    <section class="about-r8__why" aria-labelledby="why-heading"><header class="about-r8__section-head"><p>01</p><h2 id="why-heading">{copy.why}</h2></header><div class="about-r8__why-copy"><p class="about-r8__lead">{copy.whyLead}</p><p>{copy.whyBody}</p></div><div class="about-r8__beneath" aria-label={copy.beneath}><p>{copy.beneath}</p><ol>{copy.surfaces.map(([surface, question]) => <li><span>{surface}</span><i aria-hidden="true">↓</i><strong>{question}</strong></li>)}</ol></div></section>
    <section class="about-r8__study" aria-labelledby="study-heading"><header class="about-r8__section-head"><p>02</p><h2 id="study-heading">{copy.study}</h2></header><div class="about-r8__study-intro"><p>{copy.studyLead}</p></div><ol class="about-r8__scales">{copy.scales.map(([name, description], index) => <li><span>{String(index + 1).padStart(2, "0")}</span><h3>{name}</h3><p>{description}</p></li>)}</ol><aside class="about-r8__amazon-note"><span>{zh ? "旁注 / Amazon" : "Margin note / Amazon"}</span><p>{copy.amazon}</p></aside></section>
    <section class="about-r8__declaration" aria-labelledby="declaration-heading"><header class="about-r8__section-head"><p>03</p><h2 id="declaration-heading">{copy.declaration}</h2></header><div class="about-r8__declaration-columns"><div><h3>{copy.is}</h3><ul>{copy.isList.map((item) => <li>{item}</li>)}</ul></div><div><h3>{copy.isnt}</h3><ul>{copy.isntList.map((item) => <li>{item}</li>)}</ul></div></div><p class="about-r8__declaration-line">{copy.declarationLine}</p></section>
    <section class="about-r8__editor" aria-labelledby="editor-heading"><div class="about-r8__editor-copy"><header class="about-r8__section-head"><p>04</p><h2 id="editor-heading">{copy.editor}</h2></header><p class="about-r8__name">{copy.editorName}</p><p class="about-r8__role">{copy.editorRole}</p><p class="about-r8__editor-body">{copy.editorBody}</p></div><figure class="about-r8__desk-image"><img src={deskImage} alt={copy.deskAlt} /><figcaption>{copy.editorCaption}</figcaption></figure></section>
    <section class="about-r8__growth" aria-labelledby="growth-heading"><header class="about-r8__section-head"><p>05</p><h2 id="growth-heading">{copy.growth}</h2></header><p class="about-r8__growth-lead">{copy.growthLead}</p><div class="about-r8__path" aria-label={copy.growth}>{copy.path.map((item, index) => <><span class:list={{ "is-shifted": index === 1 || index === 3 }}>{item}</span>{index < copy.path.length - 1 && <i aria-hidden="true">→</i>}</>)}</div><p class="about-r8__path-note">{copy.pathNote}</p><figure class="about-r8__print-image"><img src={printImage} alt={copy.printAlt} /><figcaption>{zh ? "刊物并不向前排队；它会回到已经读过的地方。" : "A publication does not line up neatly; it returns to what it has already read."}</figcaption></figure></section>
    <footer class="about-r8__closing" aria-labelledby="unfinished-heading"><p class="about-r8__closing-number">06</p><div><h2 id="unfinished-heading">{copy.unfinished}</h2><p class="about-r8__closing-lead">{copy.unfinishedLead}</p><p>{copy.unfinishedText}</p></div><nav class="about-r8__exits" aria-label={zh ? "继续探索" : "Continue exploring"}>{copy.exits.map(([label, path], index) => <a href={localizedPath(locale, path)}><span>{String(index + 1).padStart(2, "0")}</span>{label}<i aria-hidden="true">↗</i></a>)}</nav></footer>
  </article>
</BaseLayout>

<style>
  .about-r8 { --ink: var(--color-text); --paper: var(--color-page); --green: var(--color-accent-dark); --bronze: var(--color-bronze); color: var(--ink); }
  .about-r8 :global(h1), .about-r8 :global(h2), .about-r8 :global(h3), .about-r8 :global(p), .about-r8 :global(figure), .about-r8 :global(ol), .about-r8 :global(ul) { margin-top: 0; }
  .about-r8__kicker, .about-r8__section-head > p, .about-r8__amazon-note > span, .about-r8__role, .about-r8__closing-number { color: var(--bronze); font-size: .66rem; font-weight: 720; letter-spacing: .14em; text-transform: uppercase; }
  .about-r8__opening { display: grid; grid-template-columns: minmax(0, 7fr) minmax(17rem, 4fr); gap: clamp(2rem, 6vw, 7rem); align-items: end; min-height: min(44rem, calc(100vh - 9rem)); padding: clamp(1.5rem, 4vw, 4rem) 0 clamp(4rem, 9vw, 9rem); }.about-r8__opening-copy { padding-bottom: clamp(1rem, 3vw, 3rem); }.about-r8 h1, .about-r8 h2, .about-r8__lead, .about-r8__declaration-line, .about-r8__closing-lead { font-family: var(--font-display); font-weight: 400; letter-spacing: -.035em; }.about-r8 h1 { max-width: 8.6ch; margin: .9rem 0 1.6rem; font-size: clamp(4.5rem, 8.2vw, 8.7rem); line-height: .82; }.about-r8__intro { max-width: 22ch; margin-bottom: 1rem; color: var(--color-text-secondary); font-size: clamp(1.05rem, 1.45vw, 1.35rem); line-height: 1.5; }.about-r8__intro-note { max-width: 33rem; color: var(--color-text-muted); font-size: .92rem; }
  .about-r8__hero-image, .about-r8__desk-image, .about-r8__print-image { margin-bottom: 0; }.about-r8__hero-image { position: relative; align-self: stretch; min-height: 27rem; overflow: hidden; }.about-r8__hero-image img, .about-r8__desk-image img, .about-r8__print-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.62) contrast(1.04); }.about-r8__hero-image figcaption { position: absolute; right: 0; bottom: 0; display: flex; flex-direction: column; gap: .1rem; width: min(88%, 20rem); padding: .75rem 1rem; background: color-mix(in srgb, var(--green) 94%, transparent); color: #f7f4ee; font-size: .68rem; letter-spacing: .045em; }.about-r8__hero-image figcaption span:first-child { color: #d5b478; font-size: .6rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .about-r8__why, .about-r8__study, .about-r8__declaration, .about-r8__growth { display: grid; grid-template-columns: minmax(8rem, 2fr) minmax(0, 7fr) minmax(0, 3fr); column-gap: clamp(1.5rem, 4vw, 4rem); border-top: 1px solid var(--color-border); padding: clamp(4.5rem, 10vw, 10rem) 0; }.about-r8__section-head h2 { max-width: 11ch; margin: .35rem 0 0; font-size: clamp(2rem, 3.6vw, 3.85rem); line-height: .94; }.about-r8__why-copy { grid-column: 2; max-width: 39rem; }.about-r8__why-copy p:not(.about-r8__lead), .about-r8__editor-body, .about-r8__path-note, .about-r8__closing > div > p:not(.about-r8__closing-lead) { color: var(--color-text-secondary); font-size: 1.02rem; line-height: 1.72; }.about-r8__lead { margin-bottom: 1.4rem; font-size: clamp(1.8rem, 3vw, 2.7rem); line-height: 1.04; }.about-r8__beneath { grid-column: 2 / -1; display: grid; grid-template-columns: minmax(10rem, .55fr) 1.45fr; gap: 1.5rem; margin-top: clamp(3rem, 6vw, 6rem); padding-top: 1rem; border-top: 1px solid var(--ink); }.about-r8__beneath > p { margin: 0; color: var(--bronze); font-size: .72rem; font-weight: 700; letter-spacing: .08em; }.about-r8__beneath ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; padding: 0; background: var(--color-border); list-style: none; }.about-r8__beneath li { display: flex; min-height: 10rem; flex-direction: column; padding: 1rem; background: var(--paper); }.about-r8__beneath li span { font-family: var(--font-display); font-size: clamp(1.35rem, 2.2vw, 2.05rem); }.about-r8__beneath li i { margin: auto 0 .55rem; color: var(--bronze); font-style: normal; }.about-r8__beneath li strong { max-width: 15ch; font-size: .83rem; font-weight: 620; line-height: 1.3; }
  .about-r8__study { padding-bottom: clamp(5rem, 12vw, 12rem); }.about-r8__study-intro { grid-column: 2 / -1; max-width: 36rem; margin-bottom: clamp(2.5rem, 5vw, 5rem); font-family: var(--font-display); font-size: clamp(1.7rem, 3.1vw, 3rem); line-height: 1.03; }.about-r8__scales { grid-column: 2 / -1; display: grid; grid-template-columns: 1.12fr .82fr 1.05fr; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }.about-r8__scales li { min-height: 16rem; padding: 1.25rem 1.25rem 1.5rem 0; border-bottom: 1px solid var(--color-border); }.about-r8__scales li + li { padding-left: 1.25rem; border-left: 1px solid var(--color-border); }.about-r8__scales span { color: var(--bronze); font-size: .65rem; font-weight: 700; letter-spacing: .1em; }.about-r8__scales h3 { margin: 2.5rem 0 .8rem; font-family: var(--font-display); font-size: clamp(2rem, 3.2vw, 3.5rem); font-weight: 400; line-height: .9; }.about-r8__scales p { max-width: 18rem; margin-bottom: 0; color: var(--color-text-secondary); font-size: .92rem; line-height: 1.5; }.about-r8__amazon-note { grid-column: 3; margin-top: 4rem; padding-left: 1rem; border-left: 2px solid var(--bronze); }.about-r8__amazon-note > span { display: block; margin-bottom: .6rem; }.about-r8__amazon-note p { margin: 0; color: var(--color-text-secondary); font-size: .88rem; line-height: 1.55; }
  .about-r8__declaration { background: var(--green); color: #f6f1e7; margin-inline: calc(-1 * clamp(1.25rem, 4vw, 3.5rem)); padding-inline: clamp(1.25rem, 4vw, 3.5rem); border-top: 0; }.about-r8__declaration .about-r8__section-head > p { color: #d5b478; }.about-r8__declaration-columns { grid-column: 2 / -1; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 7vw, 7rem); }.about-r8__declaration-columns h3 { margin-bottom: 1.15rem; color: #d5b478; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }.about-r8__declaration-columns ul { margin: 0; padding: 0; list-style: none; }.about-r8__declaration-columns li { padding: .58rem 0; border-top: 1px solid rgba(246, 241, 231, .22); font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.3; }.about-r8__declaration-columns div:last-child { align-self: end; color: #bccbc1; }.about-r8__declaration-line { grid-column: 2 / -1; max-width: 22ch; margin: clamp(4rem, 9vw, 9rem) 0 0; font-size: clamp(2.2rem, 4.5vw, 4.8rem); line-height: .91; }
  .about-r8__editor { display: grid; grid-template-columns: minmax(0, 7fr) minmax(14rem, 4fr); gap: clamp(2rem, 7vw, 8rem); align-items: center; padding: clamp(5rem, 11vw, 11rem) clamp(2rem, 8vw, 10rem); background: var(--color-surface-muted); }.about-r8__editor .about-r8__section-head { display: grid; grid-template-columns: minmax(4rem, 1fr) minmax(0, 5fr); gap: 1rem; }.about-r8__name { margin: clamp(3rem, 6vw, 6rem) 0 .15rem; font-size: 1.1rem; font-weight: 650; }.about-r8__role { margin-bottom: 1.5rem; }.about-r8__editor-body { max-width: 35rem; margin-bottom: 0; }.about-r8__desk-image { align-self: stretch; min-height: 24rem; }.about-r8__desk-image figcaption, .about-r8__print-image figcaption { margin-top: .6rem; color: var(--color-text-muted); font-size: .72rem; line-height: 1.45; }
  .about-r8__growth { position: relative; padding-bottom: clamp(4rem, 9vw, 8rem); }.about-r8__growth-lead { grid-column: 2 / -1; max-width: 34rem; margin-bottom: clamp(3rem, 6vw, 6rem); font-family: var(--font-display); font-size: clamp(1.65rem, 2.9vw, 2.8rem); line-height: 1.04; }.about-r8__path { grid-column: 2 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: .65rem clamp(.65rem, 2.2vw, 2rem); max-width: 60rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--ink); }.about-r8__path span { display: inline-block; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 4.2rem); line-height: .9; }.about-r8__path span.is-shifted { transform: translateY(1.1rem); }.about-r8__path i { color: var(--bronze); font-size: 1.2rem; font-style: normal; }.about-r8__path-note { grid-column: 2; max-width: 35rem; margin: 2rem 0 0; }.about-r8__print-image { grid-column: 3; grid-row: 3 / span 2; align-self: start; margin-top: 2rem; }.about-r8__print-image img { aspect-ratio: .93; }
  .about-r8__closing { display: grid; grid-template-columns: minmax(5rem, 2fr) minmax(0, 6fr) minmax(12rem, 3fr); gap: clamp(1.5rem, 4vw, 4rem); padding: clamp(3rem, 7vw, 7rem) 0 0; border-top: 1px solid var(--ink); }.about-r8__closing h2 { margin-bottom: 1.4rem; font-size: clamp(3.2rem, 6vw, 6.5rem); line-height: .82; }.about-r8__closing-lead { max-width: 15ch; margin-bottom: 1.2rem; font-size: clamp(1.7rem, 2.8vw, 2.8rem); line-height: 1.03; }.about-r8__exits { display: flex; flex-direction: column; align-items: stretch; align-self: end; }.about-r8__exits a { display: grid; grid-template-columns: 2.2rem 1fr auto; gap: .5rem; padding: .8rem 0; border-top: 1px solid var(--color-border); color: var(--green); font-size: .78rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }.about-r8__exits a:last-child { border-bottom: 1px solid var(--color-border); }.about-r8__exits a:hover, .about-r8__exits a:focus-visible { color: var(--bronze); }.about-r8__exits span { color: var(--bronze); font-size: .65rem; }.about-r8__exits i { font-style: normal; }
