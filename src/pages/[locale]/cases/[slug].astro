---
import { getCaseDisplayData, getPublishedCases } from "../../../lib/cases";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CaseArticle from "../../../components/CaseArticle.astro";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";

export async function getStaticPaths() {
  const cases = await getPublishedCases();
  return locales.flatMap((locale) =>
    cases.map((caseEntry) => ({
      params: { locale, slug: caseEntry.id },
      props: { caseEntry },
    })),
  );
}

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const { caseEntry } = Astro.props;
const available = hasCaseLocale(locale, caseEntry.id);
const displayData = getCaseDisplayData(caseEntry, locale);
const casePath = `/cases/${caseEntry.id}/`;
const languagePaths = {
  en: localizedPath("en", casePath),
  zh: localizedPath("zh", casePath),
};
const alternatePaths = {
  en: localizedPath("en", casePath),
  zh: hasCaseLocale("zh", caseEntry.id) ? localizedPath("zh", casePath) : null,
};
---

<BaseLayout title={available ? displayData.title : copy.pages.caseUnavailable.title} description={available ? displayData.summary : copy.pages.caseUnavailable.body} locale={locale} languagePaths={languagePaths} alternatePaths={alternatePaths}>
  <Breadcrumbs
    label={locale === "zh" ? "页面路径" : "Breadcrumb"}
    items={[
      { label: locale === "zh" ? "首页" : "Home", href: localizedPath(locale) },
      { label: copy.nav[0].label, href: localizedPath(locale, "/cases/") },
      { label: available ? displayData.title : copy.pages.caseUnavailable.title },
    ]}
  />
  {
    available ? (
      <CaseArticle caseEntry={caseEntry} locale={locale} />
    ) : (
      <section class="page-shell case-unavailable" aria-labelledby="case-unavailable-heading">
        <div class="page-hero">
          <p class="home-eyebrow">{copy.labels.publishedAnalysis}</p>
          <h1 id="case-unavailable-heading">{copy.pages.caseUnavailable.title}</h1>
          <p>{copy.pages.caseUnavailable.body}</p>
        </div>
        <a class="home-inline-link" href={localizedPath("en", `/cases/${caseEntry.id}/`)}>{copy.pages.caseUnavailable.action}</a>
      </section>
    )
  }
</BaseLayout>
