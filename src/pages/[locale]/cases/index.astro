---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCaseDisplayData, getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";

export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const zh = locale === "zh";
const allCases = await getDiscoveryCases();
const cases = (zh ? allCases.filter((entry) => hasCaseLocale(locale, entry.id)) : allCases)
  .sort((a, b) => Number(a.data.caseNumber ?? 999) - Number(b.data.caseNumber ?? 999));
const featured = cases.filter((entry) => entry.data.featured)[0] ?? cases[0];
const heroImage = featured?.data.heroImage ?? "/images/amazon-distribution-center.png";
const heroAlt = featured?.data.heroImageAlt ?? (zh ? "研究档案中的结构性商业空间" : "A structured business environment for the research archive");
const questions = [...getTaxonomyItems(cases, "topics", locale).map((item) => ({ type: "topics", ...item })), ...getTaxonomyItems(cases, "concepts", locale).map((item) => ({ type: "concepts", ...item }))].slice(0, 3);
const questionCopy = zh ? ["当竞争变弱，企业会获得怎样的空间？", "便利什么时候会变成依赖？", "明明有替代选择，人们为什么仍然不离开？"] : ["What happens when competition weakens?", "When does convenience become dependence?", "Why do customers stay even when better alternatives exist?"];
const questionImages = ["/images/amazon-distribution-center.png", "/images/amazon-locker-contested-convenience.png", "/images/amazon-prime-last-mile.png"];
const filters = zh ? [["all", "全部"], ["company", "公司"], ["industry", "行业"], ["topic", "主题"], ["concept", "概念"], ["year", "年份"]] : [["all", "All"], ["company", "Company"], ["industry", "Industry"], ["topic", "Topic"], ["concept", "Concept"], ["year", "Year"]];
---
<BaseLayout title={zh ? "案例库" : "Research Archive"} description={zh ? "从真实企业与市场出发，追问决策背后的结构、机制与边界。" : "Case-based investigations into markets, firms, and decisions."} locale={locale}>
  <section class="page-shell archive-v10" data-empty={zh ? "没有匹配的已发布案例。" : "No published cases match this search."} aria-labelledby="archive-heading">
    <header class="archive-v10__hero"><div class="archive-v10__hero-copy"><p class="archive-v10__eyebrow">{zh ? "研究档案" : "RESEARCH ARCHIVE"}</p><h1 id="archive-heading">{zh ? "案例库" : "Research Archive"}</h1><p>{zh ? "从真实企业与市场出发，追问决策背后的结构、机制与边界。" : "Case-based investigations into markets, firms, and decisions."}</p></div><figure><img src={heroImage} alt={heroAlt} fetchpriority="high"/><figcaption>{featured?.data.heroImageCaption}</figcaption></figure></header>
    <section class="archive-v10__search" aria-label={zh ? "搜索案例库" : "Search archive"}><form data-archive-search-form><label class="sr-only" for="archive-search">{zh ? "搜索案例、公司或主题" : "Search cases, companies, or topics"}</label><span aria-hidden="true">⌕</span><input id="archive-search" type="search" autocomplete="off" placeholder={zh ? "搜索案例、公司或主题..." : "Search cases, companies, topics..."} data-archive-search/><button type="submit" aria-label={zh ? "提交搜索" : "Submit search"}>→</button></form><p aria-live="polite" data-archive-status>{zh ? `当前收录 ${cases.length} 个已发布案例。` : `${cases.length} published ${cases.length === 1 ? "case" : "cases"} in the archive.`}</p></section>
    {featured && (() => { const item = getCaseDisplayData(featured, locale); return <section class="archive-v10__feature" aria-labelledby="featured-heading"><p class="archive-v10__eyebrow" id="featured-heading">{zh ? "精选研究" : "FEATURED RESEARCH"}</p><a href={localizedPath(locale, `/cases/${featured.id}/`)}><figure><img src={featured.data.heroImage} alt={featured.data.heroImageAlt}/><figcaption>{featured.data.heroImageCredit}</figcaption></figure><div><p>{zh ? `案例 ${featured.data.caseNumber ?? "001"}` : `CASE ${featured.data.caseNumber ?? "001"}`}</p><span>{item.entities[0]}</span><h2>{item.title}</h2><small>{item.summary}</small><ul>{item.topics.concat(item.concepts).slice(0, 4).map((tag) => <li>{tag}</li>)}</ul><footer><span>{featured.data.publishedDate.getFullYear()}　|　{zh ? `约 ${featured.data.readingTimeMinutes ?? 12} 分钟阅读` : `${featured.data.readingTimeMinutes ?? 12} min read`}</span><b>{zh ? "阅读案例" : "Read case"} <i aria-hidden="true">→</i></b></footer></div></a></section>})()}
    <section class="archive-v10__index" aria-labelledby="index-heading"><header><h2 id="index-heading">{zh ? "全部案例" : "Archive Index"}</h2><div class="archive-v10__filterbar" role="group" aria-label={zh ? "案例筛选" : "Case filters"}>{filters.map(([value, label]) => <button type="button" data-filter={value} class:list={{ "is-active": value === "all" }}>{label}</button>)}</div><label class="archive-v10__sort">{zh ? "排序：" : "Sort by: "}<select data-archive-sort aria-label={zh ? "排序方式" : "Sort cases"}><option value="latest">{zh ? "最新发布" : "Latest"}</option><option value="oldest">{zh ? "最早发布" : "Oldest"}</option><option value="alpha">A–Z</option></select></label></header><div class="archive-v10__rows" data-archive-rows>{cases.map((entry, index) => { const item = getCaseDisplayData(entry, locale); const tags = item.topics.concat(item.concepts); const search = [item.title, item.summary, item.centralQuestion, ...item.entities, ...item.topics, ...item.concepts, entry.data.caseType, String(entry.data.publishedDate.getFullYear())].join(" ").toLowerCase(); return <a class="archive-v10__row" href={localizedPath(locale, `/cases/${entry.id}/`)} data-case-row data-year={entry.data.publishedDate.getFullYear()} data-title={item.title.toLowerCase()} data-search={search} data-company={item.entities.join(" ").toLowerCase()} data-industry={entry.data.caseType === "industry" ? "true" : ""} data-topic={item.topics.join(" ").toLowerCase()} data-concept={item.concepts.join(" ").toLowerCase()}><span class="archive-v10__number">{String(index + 1).padStart(3, "0")}</span><div class="archive-v10__row-copy"><small>{item.entities[0]}</small><h3>{item.title}</h3><p>{item.summary}</p></div><figure><img src={entry.data.heroImage} alt={entry.data.heroImageAlt}/></figure><div class="archive-v10__row-meta"><ul>{tags.slice(0, 3).map((tag) => <li>{tag}</li>)}</ul><small>{entry.data.publishedDate.getFullYear()}　|　{zh ? `约 ${entry.data.readingTimeMinutes ?? 12} 分钟阅读` : `${entry.data.readingTimeMinutes ?? 12} min read`}</small></div><i aria-hidden="true">→</i></a>; })}</div><p class="archive-v10__empty" hidden data-archive-empty>{zh ? "没有匹配的已发布案例。" : "No published cases match this search."}</p></section>
    {questions.length > 0 && <section class="archive-v10__questions" aria-labelledby="questions-heading"><header><p class="archive-v10__eyebrow">{zh ? "从问题出发" : "BROWSE BY QUESTION"}</p><h2 id="questions-heading">{zh ? "沿着问题，发现更多研究" : "Explore recurring questions"}</h2></header><div>{questions.map((source, index) => <a href={localizedPath(locale, `/${source.type}/${source.slug}/`)}><img src={questionImages[index]} alt={zh ? `与${source.name}有关的研究场景` : `Research scene related to ${source.name}`}/><span><strong>{questionCopy[index]}</strong><small>{source.name}</small><i aria-hidden="true">→</i></span></a>)}</div></section>}
    <footer class="archive-v10__crosslinks" aria-label={zh ? "继续研究" : "Continue research"}>{[["Topics", "Browse recurring questions.", "/topics/", "/images/amazon-locker-contested-convenience.png"], ["Concepts", "Use analytical tools across cases.", "/concepts/", "/images/toys-r-us-monroe-aftermath.png"], ["Method", "See how judgments are built.", "/method/", "/images/amazon-prime-last-mile.png"]].map(([en, sub, href, image]) => <a href={localizedPath(locale, href)}><div><h2>{zh ? ({ Topics: "主题", Concepts: "概念", Method: "方法" }[en] ?? en) : en}</h2><p>{zh ? ({ Topics: "沿着反复出现的问题继续追问。", Concepts: "用分析工具观察不同案例。", Method: "看看判断是怎样一步步建立的。" }[en] ?? sub) : sub}</p><i aria-hidden="true">→</i></div><img src={image} alt=""/></a>)}</footer>
  </section>
  <script is:inline>
    const root = document.querySelector(".archive-v10"); const form = root?.querySelector("[data-archive-search-form]"); const input = root?.querySelector("[data-archive-search]"); const rows = [...(root?.querySelectorAll("[data-case-row]") || [])]; const status = root?.querySelector("[data-archive-status]"); const empty = root?.querySelector("[data-archive-empty]"); const sort = root?.querySelector("[data-archive-sort]"); let active = "all";
    const matches = (row) => { const q = input.value.trim().toLowerCase(); const candidate = active === "all" || ((active === "year" ? row.dataset.year : active === "company" ? row.dataset.company : row.dataset[active]) || "").length > 0; return candidate && (!q || row.dataset.search.includes(q)); };
    const update = () => { const visible = rows.filter(matches); rows.forEach(row => row.hidden = !matches(row)); empty.hidden = visible.length > 0; status.textContent = visible.length ? `${visible.length} ${visible.length === 1 ? "result" : "results"}` : root.dataset.empty; const url = new URL(window.location.href); input.value ? url.searchParams.set("q", input.value) : url.searchParams.delete("q"); active !== "all" ? url.searchParams.set("filter", active) : url.searchParams.delete("filter"); history.replaceState({}, "", url); };
    const sortRows = () => { const ordered = [...rows].sort((a,b) => sort.value === "alpha" ? a.dataset.title.localeCompare(b.dataset.title) : sort.value === "oldest" ? Number(a.dataset.year)-Number(b.dataset.year) : Number(b.dataset.year)-Number(a.dataset.year)); ordered.forEach(row => row.parentElement.append(row)); };
    const initial = new URLSearchParams(window.location.search); input.value = initial.get("q") || ""; active = initial.get("filter") || "all"; root?.querySelectorAll("[data-filter]").forEach(btn => { btn.classList.toggle("is-active", btn.dataset.filter === active); btn.addEventListener("click", () => { active = btn.dataset.filter; root.querySelectorAll("[data-filter]").forEach(item => item.classList.toggle("is-active", item === btn)); update(); }); }); form?.addEventListener("submit", event => { event.preventDefault(); update(); }); input?.addEventListener("input", update); sort?.addEventListener("change", sortRows); update();
  </script>
</BaseLayout>
