---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResearchMark from "../../../components/discovery/ResearchMark.astro";
import { getCaseDisplayData, getDiscoveryCases } from "../../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const allCases = await getDiscoveryCases();
const cases = locale === "zh" ? allCases.filter((entry) => hasCaseLocale(locale, entry.id)) : allCases;
const featured = cases.find((entry) => entry.data.featured) ?? cases[0];
const zh = locale === "zh";
---
<BaseLayout title={zh ? "案例" : "Cases"} description={copy.pages.cases.description} locale={locale}>
  <section class="page-shell cases-r8" aria-labelledby="cases-heading">
    {featured && (() => { const item = getCaseDisplayData(featured, locale); return <>
      <header class="cases-r8__entry">
        <div class="cases-r8__entry-intro"><p class="discovery-kicker"><ResearchMark kind="case" />{zh ? "研究档案" : "Research archive"}</p><h1 id="cases-heading" data-cms="title">{zh ? "案例" : "Cases"}</h1><p data-cms="description">{zh ? "围绕值得追问的商业问题，连接证据、机制与有边界的判断。" : "A slowly built archive of questions, evidence, mechanisms, and bounded judgement."}</p></div>
        <figure class="cases-r8__entry-image"><img src={featured.data.heroImage} alt={featured.data.heroImageAlt}/><figcaption>{featured.data.heroImageCaption}</figcaption></figure>
        <a class="cases-r8__dossier-tab" href={localizedPath(locale, `/cases/${featured.id}/`)}><span>{zh ? "当前档案" : "Current dossier"}</span><strong><ResearchMark kind="case" />{zh ? "案例" : "Case"} {featured.data.caseNumber ?? "001"}</strong><b>{item.entities[0]}</b><small>{item.topics.join(" · ")}<br/>{featured.data.readingTimeMinutes ?? 12} {zh ? "分钟阅读" : "min read"} <i aria-hidden="true">↗</i></small></a>
        <dl class="cases-r8__archive-count"><div><dt>{zh ? "已发布研究" : "Published research"}</dt><dd>{String(cases.length).padStart(2, "0")}</dd></div><div><dt>{zh ? "分析镜头" : "Analytical lenses"}</dt><dd>{String(item.concepts.length).padStart(2, "0")}</dd></div></dl>
      </header>
      <article class="cases-r8__snapshot" aria-labelledby="snapshot-title">
        <a class="cases-r8__snapshot-case" href={localizedPath(locale, `/cases/${featured.id}/`)}><span>{zh ? "当前正式研究" : "Current formal research"}</span><strong>{item.entities[0]}</strong><small>{zh ? "打开案例记录" : "Open case record"} <i aria-hidden="true">↗</i></small></a>
        <a class="cases-r8__snapshot-question" href={localizedPath(locale, "/topics/competition/")}><p class="discovery-kicker">{copy.labels.centralQuestion}</p><h2 id="snapshot-title">{item.centralQuestion}</h2></a>
        <div class="cases-r8__snapshot-signal"><p><ResearchMark kind="evidence" />{zh ? "观察信号" : "Observed signal"}</p><strong>≈4%</strong><span>{zh ? "竞争者退出后，亚马逊玩具价格出现的比较信号。" : "Observed comparative signal after a major rival’s exit."}</span></div>
        <aside class="cases-r8__snapshot-note"><p>{zh ? "发生了什么变化？" : "What changed?"}</p><span>{zh ? "研究比较了 Toys “R” Us 退出美国市场、而加拿大仍保留更久之后的价格模式。" : "The research compares price patterns after Toys “R” Us exited the U.S. while remaining active longer in Canada."}</span></aside>
      </article>
      <section class="cases-r8__field" aria-labelledby="questions-heading"><header><p class="discovery-kicker">{zh ? "调查场" : "Discovery field"}</p><h2 id="questions-heading">{zh ? "从问题进入这项研究。" : "Enter this investigation through a question."}</h2><p>{zh ? "三条研究路线，通向同一份当前档案。" : "Three research routes lead into one current dossier."}</p></header><div class="cases-r8__routes"><a href={localizedPath(locale,"/topics/competition/")}><span>01 / {zh ? "主题" : "Topic"}</span><strong>{zh ? "当竞争消失时，会发生什么？" : "What happens when competition disappears?"}</strong><i aria-hidden="true">↗</i></a><a href={localizedPath(locale,"/topics/market-power/")}><span>02 / {zh ? "主题" : "Topic"}</span><strong>{zh ? "便利何时会变成力量？" : "When does convenience become power?"}</strong><i aria-hidden="true">↗</i></a><a href={localizedPath(locale,"/concepts/competitive-constraint/")}><span>03 / {zh ? "分析镜头" : "Lens"}</span><strong>{zh ? "谁仍然可以约束这家公司？" : "Who can still constrain the firm?"}</strong><i aria-hidden="true">↗</i></a></div></section>
      <a class="cases-r8__formal-record" href={localizedPath(locale, `/cases/${featured.id}/`)}><span><ResearchMark kind="evidence" />{zh ? "正式记录 / 已发布" : "Formal record / published"}</span><div><p>{zh ? "案例" : "Case"} {featured.data.caseNumber ?? "001"}</p><h2>{item.title}</h2><small>{item.centralQuestion}</small></div><aside><p>{zh ? "研究关系" : "Research relations"}</p><span>{item.topics.join(" · ")}<br/>{item.concepts.join(" · ")}</span><b>{zh ? "打开档案" : "Open dossier"} <i aria-hidden="true">↗</i></b></aside></a>
    </>})()}
    <nav class="cases-r8__index" aria-label={zh ? "研究连接" : "Research connections"}><span><ResearchMark kind="connection" />{zh ? "研究索引" : "Research index"}</span><a href={localizedPath(locale, "/topics/competition/")}>{zh ? "竞争" : "Competition"}</a><a href={localizedPath(locale, "/topics/market-power/")}>{zh ? "市场力量" : "Market Power"}</a><a href={localizedPath(locale, "/concepts/pricing-power/")}>{zh ? "定价权" : "Pricing Power"}</a><a href={localizedPath(locale, "/concepts/switching-costs/")}>{zh ? "转换成本" : "Switching Costs"}</a><a href={localizedPath(locale, "/concepts/competitive-constraint/")}>{zh ? "竞争约束" : "Competitive Constraint"}</a></nav>
    <footer class="cases-r8__closing"><p>{zh ? "每一个答案，都会打开下一个问题。" : "Every answer opens another question."}</p><nav aria-label={zh ? "继续研究" : "Continue research"}><a href={localizedPath(locale, "/topics/")}>{zh ? "探索主题" : "Explore Topics"}</a><a href={localizedPath(locale, "/concepts/")}>{zh ? "浏览概念" : "Browse Concepts"}</a><a href={localizedPath(locale, "/#one-more-question")}>{zh ? "另一个问题" : "One More Question"}</a></nav></footer>
  </section>
</BaseLayout>
