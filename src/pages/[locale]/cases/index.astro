---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResearchMark from "../../../components/discovery/ResearchMark.astro";
import { getCaseDisplayData, getDiscoveryCases } from "../../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const allCases = await getDiscoveryCases();
const cases = locale === "zh" ? allCases.filter((entry) => hasCaseLocale(locale, entry.id)) : allCases;
const featured = cases.find((entry) => entry.data.featured) ?? cases[0];
const zh = locale === "zh";
---
<BaseLayout title={zh ? "案例" : "Cases"} description={copy.pages.cases.description} locale={locale}>
  <section class="page-shell discovery-round2 cases-v21" aria-labelledby="cases-heading">
    {featured && (() => { const item = getCaseDisplayData(featured, locale); return <header class="archive-opening"><div class="archive-opening__copy"><p class="discovery-kicker"><ResearchMark kind="case" />{zh ? "研究档案" : "Research archive"}</p><h1 id="cases-heading">{zh ? "案例" : "Cases"}</h1><p>{zh ? "围绕值得追问的商业问题，连接证据、机制与有边界的判断。" : "A slowly built archive of questions, evidence, mechanisms, and bounded judgement."}</p><dl><div><dt>{zh ? "已发布研究" : "Published research"}</dt><dd>{String(cases.length).padStart(2, "0")}</dd></div><div><dt>{zh ? "研究主题" : "Research topics"}</dt><dd>{String(item.topics.length).padStart(2, "0")}</dd></div><div><dt>{zh ? "分析镜头" : "Analytical lenses"}</dt><dd>{String(item.concepts.length).padStart(2, "0")}</dd></div></dl></div><figure class="archive-opening__image"><img src={featured.data.heroImage} alt={featured.data.heroImageAlt}/><figcaption><span><ResearchMark kind="case" />{zh ? "案例" : "Case"} {featured.data.caseNumber ?? "001"}</span><strong>{item.entities[0]}</strong><small>{item.topics.join(" / ")} · {featured.data.readingTimeMinutes ?? 12} {zh ? "分钟阅读" : "min read"}</small></figcaption></figure></header>})()}
    {featured && (() => { const item = getCaseDisplayData(featured, locale); return <>
      <article class="archive-feature-spread" aria-labelledby="feature-title"><a class="archive-feature-spread__case" href={localizedPath(locale, `/cases/${featured.id}/`)}><p>{zh ? "当前正式研究" : "Current formal research"}</p><span><ResearchMark kind="case" />{zh ? "案例" : "Case"} {featured.data.caseNumber ?? "001"}</span><h2 id="feature-title">{item.entities[0]}</h2></a><a class="archive-feature-spread__question" href={localizedPath(locale, `/topics/competition/`)}><p class="discovery-kicker">{copy.labels.centralQuestion}</p><h3>{item.centralQuestion}</h3></a><div class="archive-feature-spread__signal"><p><ResearchMark kind="evidence" />{zh ? "关键信号" : "Key signal"}</p><strong>≈4%</strong><span>{zh ? "竞争者退出后，亚马逊玩具价格出现的比较信号。" : "Observed comparative signal after a major rival’s exit."}</span></div><div class="archive-feature-spread__context"><p>{zh ? "发生了什么变化？" : "What changed?"}</p><span>{zh ? "在 Toys “R” Us 退出美国市场、而加拿大仍保留更久的条件下，研究比较了价格模式。" : "The research compares price patterns after Toys “R” Us exited the U.S. while remaining active longer in Canada."}</span></div></article>
      <section class="discovery-field" aria-labelledby="questions-heading"><header><p class="discovery-kicker">{zh ? "调查场": "Discovery field"}</p><h2 id="questions-heading">{zh ? "从问题进入这项研究。" : "Enter this investigation through a question."}</h2></header><div class="discovery-field__routes"><a href={localizedPath(locale,"/topics/competition/")}><div><span>{zh ? "主题": "Topic"}</span><strong>{zh ? "当竞争消失时，会发生什么？" : "What happens when competition disappears?"}</strong></div><ResearchMark kind="connection" /></a><a href={localizedPath(locale,"/topics/market-power/")}><div><span>{zh ? "主题": "Topic"}</span><strong>{zh ? "便利何时会变成力量？" : "When does convenience become power?"}</strong></div><ResearchMark kind="connection" /></a><a href={localizedPath(locale,"/concepts/competitive-constraint/")}><div><span>{zh ? "分析镜头": "Lens"}</span><strong>{zh ? "谁仍然可以约束这家公司？" : "Who can still constrain the firm?"}</strong></div><ResearchMark kind="connection" /></a></div><a class="discovery-field__record" href={localizedPath(locale, `/cases/${featured.id}/`)}><span><ResearchMark kind="evidence" />{zh ? "当前正式记录": "Current formal record"}</span><strong>{item.title}</strong><p>{item.centralQuestion}</p></a></section>
    </>})()}
    <section class="archive-connection" aria-label={zh ? "研究连接" : "Research connections"}><ResearchMark kind="connection" /><p>{zh ? "继续追问" : "Continue through"}</p><a href={localizedPath(locale, "/topics/competition/")}>{zh ? "竞争" : "Competition"}</a><a href={localizedPath(locale, "/topics/market-power/")}>{zh ? "市场力量" : "Market Power"}</a><a href={localizedPath(locale, "/concepts/competitive-constraint/")}>{zh ? "竞争约束" : "Competitive Constraint"}</a></section>
    <section class="archive-closing"><p>{zh ? "每一个答案，都会打开下一个问题。" : "Every answer opens another question."}</p><div><a href={localizedPath(locale, "/topics/")}>{zh ? "探索主题" : "Explore topics"}</a><a href={localizedPath(locale, "/concepts/")}>{zh ? "浏览概念" : "Browse concepts"}</a><a href={localizedPath(locale, "/#one-more-question")}>{zh ? "另一个问题" : "One More Question"}</a></div></section>
  </section>
</BaseLayout>
