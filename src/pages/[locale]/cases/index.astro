---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { formatDate, getPublishedCases } from "../../../lib/cases";
import { getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const copy = getSiteCopy(locale);
const publishedCases = await getPublishedCases();
const cases = locale === "zh" ? publishedCases.filter((caseEntry) => hasCaseLocale(locale, caseEntry.id)) : publishedCases;
---

<BaseLayout title={locale === "zh" ? "案例" : "Cases"} description={copy.pages.cases.description} locale={locale}>
  <section class="page-shell cases-page" aria-labelledby="cases-heading">
    <div class="library-hero">
      <div>
        <p class="home-eyebrow">{locale === "zh" ? "案例" : "Cases"}</p>
        <h1 id="cases-heading">{copy.pages.cases.title}</h1>
      </div>
      <div class="library-hero__panel">
        <strong>{copy.pages.cases.count(cases.length)}</strong>
        <p>{copy.pages.cases.note}</p>
      </div>
    </div>

    <section class="library-discovery" aria-label="Case library discovery">
      <p>{copy.search.placeholder}</p>
      <span>{copy.pages.cases.discovery}</span>
    </section>

    <ol class="library-list">
      {cases.map((caseEntry) => (
        <li>
          <div class="library-list__meta">
            <time datetime={caseEntry.data.publishedDate.toISOString()}>{formatDate(caseEntry.data.publishedDate)}</time>
            <span>{caseEntry.data.caseType} {copy.labels.case}</span>
          </div>
          <div class="library-list__body">
            <h2><a href={localizedPath(locale, `/cases/${caseEntry.id}/`)}>{caseEntry.data.title}</a></h2>
            <p class="library-question">{caseEntry.data.centralQuestion}</p>
            <p>{caseEntry.data.summary}</p>
            <dl class="library-taxonomy">
              <div><dt>{copy.labels.entities}</dt><dd>{caseEntry.data.entities.join(", ")}</dd></div>
              <div><dt>{copy.labels.topics}</dt><dd>{caseEntry.data.topics.join(", ")}</dd></div>
              <div><dt>{copy.labels.concepts}</dt><dd>{caseEntry.data.concepts.join(", ")}</dd></div>
            </dl>
          </div>
          <a class="library-read" href={localizedPath(locale, `/cases/${caseEntry.id}/`)}>{copy.labels.read}</a>
        </li>
      ))}
    </ol>
    {cases.length === 0 && locale === "zh" && (
      <p class="library-empty">
        {copy.pages.cases.empty} <a href={localizedPath("en", "/cases/")}>先看英文案例库 -></a>
      </p>
    )}
  </section>
</BaseLayout>
