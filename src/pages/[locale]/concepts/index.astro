---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResearchMark from "../../../components/discovery/ResearchMark.astro";
import { getDiscoveryCases } from "../../../lib/cases";
import { formatConceptCaseCount, getFeaturedConcepts, getPublishedConcepts } from "../../../lib/concepts";
import { hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en"; const zh=locale==="zh";
const all=await getDiscoveryCases();const featuredConcepts=getFeaturedConcepts(all);const publishedConcepts=getPublishedConcepts(all);
const heroImage={src:"https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1800&q=85",alt:zh?"超市货架上的不同商品选择":"Several competing choices on a grocery shelf"};
const responsiveSrc=(src:string)=>`${src.replace(/w=\d+/,"w=720")} 720w, ${src.replace(/w=\d+/,"w=1200")} 1200w, ${src.replace(/w=\d+/,"w=1800")} 1800w`;
---
<BaseLayout title={zh ? "概念" : "Concepts"} description={zh ? "问溯的分析概念：从真实商业情境中看见机制、压力与行动空间。" : "Understory's analytical concepts for seeing mechanisms, pressure, and room to act in real business situations."} locale={locale}>
<section class="page-shell concepts-r9" aria-labelledby="concepts-heading">
  <header class="concepts-r9__hero"><figure><img src={heroImage.src} srcset={responsiveSrc(heroImage.src)} sizes="100vw" alt={heroImage.alt} fetchpriority="high"/><figcaption>{zh?"情境影像 / 选择与替代":"Contextual image / choice and alternatives"}</figcaption></figure><div class="concepts-r9__hero-copy"><p class="discovery-kicker"><ResearchMark kind="concept" />{zh?"概念":"Concepts"}</p><h1 id="concepts-heading">{zh?"从表象出发，看见背后的结构。":"Tools for seeing what changes beneath the surface."}</h1><p>{zh?"概念不是标签，而是帮助我们理解真实商业情境的分析工具：从现象出发，辨认结构，追溯机制，再回到案例中检验。":"Concepts are not labels. They are analytical instruments: begin with what is visible, identify the structure, trace the mechanism, and test it in a case."}</p></div><aside><p>{zh?"从观察到判断":"From observation to judgment"}</p><ol>{(zh?["看见现象","命名概念","追溯机制","在案例中应用"]:["See it","Name it","Trace the mechanism","Apply it in a case"]).map((step)=><li>{step}</li>)}</ol></aside></header>
  <section class="concepts-r9__featured" aria-labelledby="featured-concepts-heading"><header><p class="discovery-kicker">{zh?"重点分析概念":"Featured analytical instruments"}</p><h2 id="featured-concepts-heading">{zh?"从一个具体问题开始。":"Begin with a question that can be tested."}</h2><p>{zh?"每个概念都从可观察的商业情境进入，而不是停在定义里。":"Each concept starts with an observable business situation, rather than ending at a definition."}</p></header><div class="concepts-r9__featured-list">{featuredConcepts.map((concept,index)=>concept.image&&<article class="concepts-r9__row"><div class="concepts-r9__identity"><p>{String(index+1).padStart(2,"0")}</p><span>{zh?"分析概念":"Analytical instrument"}</span><h3>{concept.title[locale]}</h3><p>{concept.shortDefinition[locale]}</p><a href={localizedPath(locale,`/concepts/${concept.slug}/`)}>{zh?"了解这个概念":"Explore this concept"} <i>→</i></a></div><figure><img src={concept.image.src} srcset={responsiveSrc(concept.image.src)} sizes="(max-width: 760px) calc(100vw - 40px), 32vw" alt={concept.image.alt[locale]} loading={index===0?"eager":"lazy"}/><figcaption>{concept.image.caption[locale]}<small>{concept.image.credit}</small></figcaption></figure><aside><p>{zh?"这个概念真正要问的是：":"The question this concept asks:"}</p><strong>{concept.keyQuestion[locale]}</strong><small>{formatConceptCaseCount(locale,zh?concept.cases.filter((caseEntry)=>hasCaseLocale("zh",caseEntry.id)).length:concept.cases.length)}</small></aside></article>)}</div></section>
  <section class="concepts-r9__index" aria-labelledby="concept-index-heading"><header><p class="discovery-kicker">{zh?"概念一览":"Concepts at a glance"}</p><h2 id="concept-index-heading">{zh?"这些概念，通常相互关联。":"Instruments do not work alone."}</h2><p>{zh?"这里收录所有已发布概念。随着案例与概念增加，索引会自然延展。":"This index holds every published concept and expands naturally as the archive grows."}</p></header><div class="concepts-r9__index-grid">{publishedConcepts.map((concept,index)=><a href={localizedPath(locale,`/concepts/${concept.slug}/`)}>{concept.image&&<img src={concept.image.src} alt="" loading="lazy"/>}<span>{String(index+1).padStart(2,"0")}</span><strong>{concept.title[locale]}</strong><p>{concept.keyQuestion[locale]}</p><i>↗</i></a>)}</div></section>
</section></BaseLayout>
