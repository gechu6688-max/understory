---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FieldGuideMechanism from "../../../components/discovery/FieldGuideMechanism.astro";
import ResearchMark from "../../../components/discovery/ResearchMark.astro";
import { getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { conceptDescriptions, getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
import { discoveryContent } from "../../../lib/discovery";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en"; const copy=getSiteCopy(locale); const zh=locale==="zh";
const all=await getDiscoveryCases();const cases=locale==="zh"?all.filter((entry)=>hasCaseLocale(locale,entry.id)):all;const concepts=getTaxonomyItems(cases,"concepts");
---
<BaseLayout title={copy.pages.concepts.eyebrow} description={copy.pages.concepts.description} locale={locale}>
<section class="page-shell discovery-round2 concepts-v21" aria-labelledby="concepts-heading">
 <header class="fieldguide-intro-v21 fieldguide-intro-v3"><div><p class="discovery-kicker"><ResearchMark kind="concept" />{zh?"概念观察":"Analytical instruments"}</p><h1 id="concepts-heading">{zh?"机制，而非标签。":"Mechanisms, not labels."}</h1></div><p>{zh?"概念是帮助我们辨认商业机制的观察工具。每一个镜头，都在说明什么约束、什么保留、什么摩擦。":"A field guide for recognizing what constrains, what remains after a change, and what makes leaving harder."}</p></header>
 <section class="concept-modules concept-modules-v3">{concepts.map((concept,index)=>{const data=discoveryContent(locale,concept.name);return <article class:list={["concept-module",`concept-module--${concept.slug}`]} data-concept-index={String(index+1).padStart(2,"0")}><div class="concept-module__visual">{concept.slug !== "pricing-power" && <p>{String(index+1).padStart(2,"0")}</p>}<FieldGuideMechanism concept={concept.slug} locale={locale}/></div><div class="concept-module__content"><p class="discovery-kicker">{zh?"分析镜头":"Analytical lens"}</p><h2>{concept.name}</h2><p class="concept-definition">{conceptDescriptions[locale][concept.name]??conceptDescriptions.en[concept.name]}</p><blockquote>{data.question}</blockquote><p class="learn-label">{zh?"学会辨认":"Learn to spot it"}</p><ol>{data.signals.slice(0,3).map((signal,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{signal}</li>)}</ol><footer><small>{zh?"用于":"Used in"} {concept.cases.length} {zh?"项正式案例":"formal case"}</small><a href={localizedPath(locale,`/concepts/${concept.slug}/`)}>{zh?"理解概念":"Explore lens"}</a></footer></div></article>})}</section>
 <section class="concept-sequence"><div><p class="discovery-kicker">{zh?"概念连接":"Concepts connect"}</p><h2>{zh?"概念共同解释行动空间。":"Together, the lenses explain room to act."}</h2></div><div class="concept-sequence__path"><a href={localizedPath(locale,"/concepts/competitive-constraint/")}>{zh?"竞争约束":"Competitive Constraint"}</a><i>{zh?"可能减弱":"can weaken"} ↓</i><strong>{zh?"行动空间":"Room to act"}</strong><i>{zh?"可能带来":"may create"} ↓</i><a href={localizedPath(locale,"/concepts/pricing-power/")}>{zh?"定价权":"Pricing Power"}</a><span>{zh?"转换成本会影响约束在实践中的强度。":"Switching costs can affect the practical strength of constraint."}</span></div></section>
</section></BaseLayout>
