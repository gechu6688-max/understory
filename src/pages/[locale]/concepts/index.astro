---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ConceptDiagram from "../../../components/discovery/ConceptDiagram.astro";
import ConnectionDiagram from "../../../components/discovery/ConnectionDiagram.astro";
import { getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { conceptDescriptions, getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
import { discoveryContent } from "../../../lib/discovery";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en"; const copy=getSiteCopy(locale); const zh=locale==="zh";
const all=await getDiscoveryCases();const cases=locale==="zh"?all.filter((entry)=>hasCaseLocale(locale,entry.id)):all;const concepts=getTaxonomyItems(cases,"concepts");
---
<BaseLayout title={copy.pages.concepts.eyebrow} description={copy.pages.concepts.description} locale={locale}>
<section class="page-shell discovery-round2 concepts-v21" aria-labelledby="concepts-heading">
 <header class="fieldguide-intro-v21"><div><p class="discovery-kicker">{zh?"概念 / 观察手册":"Concepts / Field Guide"}</p><h1 id="concepts-heading">{zh?"理解表面之下的工具。":"Tools for seeing beneath the surface."}</h1></div><p>{zh?"概念是帮助我们辨认商业机制的观察工具，而不是漂亮的标签。":"Analytical lenses for recognizing mechanisms beneath a business story."}</p></header>
 <section class="concept-modules">{concepts.map((concept,index)=>{const data=discoveryContent(locale,concept.name);return <article class:list={["concept-module",`concept-module--${concept.slug}`]}><div class="concept-module__visual"><p>{String(index+1).padStart(2,"0")}</p><ConceptDiagram concept={concept.slug} label={concept.name}/></div><div class="concept-module__content"><p class="discovery-kicker">{zh?"分析镜头":"Analytical lens"}</p><h2>{concept.name}</h2><p class="concept-definition">{conceptDescriptions[locale][concept.name]??conceptDescriptions.en[concept.name]}</p><blockquote>{data.question}</blockquote><ol>{data.signals.slice(0,3).map((signal,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{signal}</li>)}</ol><footer><small>{zh?"用于":"Used in"} {concept.cases.length} {zh?"项正式案例":"formal case"}</small><a href={localizedPath(locale,`/concepts/${concept.slug}/`)}>{zh?"理解概念":"Explore lens"} →</a></footer></div></article>})}</section>
 <section class="dark-research-module concepts-connect"><div><p class="discovery-kicker">{zh?"概念连接":"Concepts connect"}</p><h2>{zh?"概念很少单独起作用。":"Concepts rarely work alone."}</h2><p>{zh?"用多个镜头一起看，才能把市场力量、竞争约束与选择的摩擦放在同一个画面里。":"Use several lenses together to place power, constraint, and switching friction in the same view."}</p></div><ConnectionDiagram locale={locale} mode="concept" /></section>
</section></BaseLayout>
