---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FieldGuideMechanism from "../../../components/discovery/FieldGuideMechanism.astro";
import ResearchMark from "../../../components/discovery/ResearchMark.astro";
import { getDiscoveryCases, getTaxonomyItems } from "../../../lib/cases";
import { conceptDescriptions, getSiteCopy, hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";
import { discoveryContent } from "../../../lib/discovery";
export function getStaticPaths(){return locales.map((locale)=>({params:{locale}}));}
const locale=isLocale(Astro.params.locale)?Astro.params.locale:"en"; const copy=getSiteCopy(locale); const zh=locale==="zh";
const all=await getDiscoveryCases();const cases=locale==="zh"?all.filter((entry)=>hasCaseLocale(locale,entry.id)):all;const concepts=getTaxonomyItems(cases,"concepts");
const heroImage={src:"https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1800&q=85",alt:zh?"超市货架上的不同商品选择":"Several competing choices on a grocery shelf"};
const images={
  "competitive-constraint":{src:"https://images.unsplash.com/photo-1785411007575-3f85e71a2adf?auto=format&fit=crop&w=1800&q=85",alt:zh?"玻璃目录牌上并列的多个商家选项":"Multiple businesses listed together on a glass directory",role:zh?"替代选项只有在真实可见、可达时才会形成竞争压力。此图仅作情境说明，并非经验证据。":"Alternatives create competitive pressure only when they are visible and reachable in practice. Contextual image, not evidence.",source:"Unsplash · Heng Chiu · wQUJzhhJXuk"},
  "pricing-power":{src:"https://images.unsplash.com/photo-1750262727446-759032bf283f?auto=format&fit=crop&w=1800&q=85",alt:zh?"零售柜台上的支付终端":"A payment terminal on a retail counter",role:zh?"交易条件改变后，需求是否仍然留存，决定了行动空间。此图仅作情境说明，并非经验证据。":"Room to act depends on whether demand remains after transaction terms change. Contextual image, not evidence.",source:"Unsplash · SumUp · 5RVD3VVNWeI"},
  "switching-costs":{src:"https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=1500&q=85",alt:zh?"履约基础设施中的成排货物":"Rows of goods within fulfillment infrastructure",role:zh?"重复的流程、数据和基础设施会让离开变得比一次选择更困难。此图仅作情境说明，并非经验证据。":"Repeated process, data, and infrastructure can make leaving harder than a single choice. Contextual image, not evidence.",source:"Unsplash · photo-1586528116311-ad8dd3c8310d"}
};
const anatomy={
  "competitive-constraint":zh?{see:"看见替代",mechanism:"压力来自可行的外部选择",watch:"观察：替代是否仍然可达"}:{see:"See alternatives",mechanism:"Pressure comes from workable outside options",watch:"Watch: can an alternative still be reached?"},
  "pricing-power":zh?{see:"看见留存",mechanism:"空间来自条件变化后仍被接受",watch:"观察：改变后谁还会留下"}:{see:"See retention",mechanism:"Room comes from acceptance after terms change",watch:"Watch: who remains after a change?"},
  "switching-costs":zh?{see:"看见摩擦",mechanism:"摩擦把选择变成迁移",watch:"观察：时间、数据与中断成本"}:{see:"See friction",mechanism:"Friction turns choice into migration",watch:"Watch: time, data, and interruption costs"}
};
---
<BaseLayout title={copy.pages.concepts.eyebrow} description={copy.pages.concepts.description} locale={locale}>
<section class="page-shell concepts-r8 concepts-r81" aria-labelledby="concepts-heading">
  <header class="concepts-r8__opening">
    <figure><img src={heroImage.src} alt={heroImage.alt} fetchpriority="high"/><figcaption>{zh?"情境影像 / 选择与替代":"Contextual image / choice and alternatives"}</figcaption></figure>
    <div class="concepts-r8__opening-copy"><p class="discovery-kicker"><ResearchMark kind="concept" />{zh?"分析工具 / 现场指南":"Analytical instruments / field guide"}</p><h1 id="concepts-heading">{zh?"看见表面之下，什么正在改变。":"Tools for seeing what changes beneath the surface."}</h1><p>{zh?"这些不是标签，而是用来观察选择、压力和行动空间的工具。先在现实中看见它，再用机制理解它。":"These are not labels. They are instruments for observing choice, pressure, and room to act: see it in the world, then understand the mechanism."}</p></div>
    <aside><span>{zh?"从观察到判断":"From observation to judgment"}</span><ol><li>{zh?"看见现实场景":"See it"}</li><li>{zh?"命名分析工具":"Name it"}</li><li>{zh?"追踪机制":"Trace the mechanism"}</li><li>{zh?"带入调查":"Apply it"}</li></ol></aside>
  </header>
  <section class="concepts-r8__instruments" aria-label={zh?"重点分析工具":"Featured analytical instruments"}>
    <header><p class="discovery-kicker">{zh?"重点分析工具":"Featured analytical instruments"}</p><p>{zh?"每个工具从一个可观察的商业场景开始，而不是从定义开始。":"Each instrument begins with an observable business situation, rather than a definition."}</p></header>
    {concepts.map((concept,index)=>{const data=discoveryContent(locale,concept.name);const image=images[concept.slug as keyof typeof images];const item=anatomy[concept.slug as keyof typeof anatomy];return <article class:list={["concept-instrument",`concept-instrument--${concept.slug}`]}><a class="concept-instrument__route" href={localizedPath(locale,`/concepts/${concept.slug}/`)} aria-label={`${zh?"探索":"Explore"} ${concept.name}`}><figure class="concept-instrument__image"><img src={image.src} alt={image.alt} loading={index===0?"eager":"lazy"}/><figcaption><span>{item.see}</span>{image.role}<small>{image.source}</small></figcaption></figure><div class="concept-instrument__identity"><p class="concept-instrument__number">{String(index+1).padStart(2,"0")}</p><p class="discovery-kicker">{zh?"分析仪器":"Analytical instrument"}</p><h2>{concept.name}</h2><p class="concept-instrument__definition">{conceptDescriptions[locale][concept.name]??conceptDescriptions.en[concept.name]}</p><blockquote>{data.question}</blockquote></div><div class="concept-instrument__mechanism"><p>{zh?"机制":"Mechanism"}</p><FieldGuideMechanism concept={concept.slug} locale={locale}/><strong>{item.mechanism}</strong></div><div class="concept-instrument__reading"><div class="concept-instrument__signals"><p>{item.watch}</p><ol>{data.signals.slice(0,3).map((signal,i)=><li><span>{String(i+1).padStart(2,"0")}</span>{signal}</li>)}</ol></div><footer><small>{zh?"用于":"Used in"} {concept.cases.length} {zh?"项正式案例":"formal case"}</small><b>{zh?"打开工具":"Open instrument"} <i>↗</i></b></footer></div></a></article>})}
  </section>
  <section class="concepts-r8__fieldguide" aria-labelledby="fieldguide-heading"><header><p class="discovery-kicker">{zh?"现场指南 / 索引":"Field guide / index"}</p><h2 id="fieldguide-heading">{zh?"用一个问题，选择一个观察镜头。":"Choose a lens by the question it helps you ask."}</h2></header><div>{concepts.map((concept,index)=>{const data=discoveryContent(locale,concept.name);return <a href={localizedPath(locale,`/concepts/${concept.slug}/`)}><span>{String(index+1).padStart(2,"0")}</span><strong>{concept.name}</strong><p>{data.question}</p><i>↗</i></a>})}</div></section>
  <section class="concepts-r8__relationships"><header><p class="discovery-kicker">{zh?"概念关系":"Concept relationships"}</p><h2>{zh?"工具不会单独工作。":"Instruments do not work alone."}</h2></header><div class="concepts-r8__path"><a href={localizedPath(locale,"/concepts/competitive-constraint/")}><small>{zh?"外部选择施压":"Outside options apply pressure"}</small>{zh?"竞争约束":"Competitive Constraint"}</a><span>{zh?"约束减弱，行动空间可能扩大":"When constraint weakens, room can expand"}</span><a href={localizedPath(locale,"/concepts/pricing-power/")}><small>{zh?"条件变化后，谁仍然留下？":"Who remains after terms change?"}</small>{zh?"定价权":"Pricing Power"}</a><p>{zh?"转换成本影响替代方案在现实中是否真正可用。":"Switching costs determine whether an alternative is usable in practice."}</p><a href={localizedPath(locale,"/concepts/switching-costs/")}><small>{zh?"离开需要付出什么？":"What does leaving require?"}</small>{zh?"转换成本":"Switching Costs"}</a></div></section>
</section></BaseLayout>
