---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getDiscoveryCases } from "../../../lib/cases";
import { formatConceptCaseCount, getFeaturedConcepts, getPublishedConcepts } from "../../../lib/concepts";
import { hasCaseLocale, isLocale, locales, localizedPath } from "../../../lib/siteCopy";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = isLocale(Astro.params.locale) ? Astro.params.locale : "en";
const zh = locale === "zh";
const cases = await getDiscoveryCases();
const featured = getFeaturedConcepts(cases).slice(0, 4);
const [leadConcept, ...supportingConcepts] = featured;
const published = getPublishedConcepts(cases);
const heroImage = {
  src: "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1800&q=85",
  alt: zh ? "超市货架上的不同商品选择" : "Several competing choices on a grocery shelf",
};
const responsiveSrc = (src: string) =>
  `${src.replace(/w=\d+/, "w=720")} 720w, ${src.replace(/w=\d+/, "w=1200")} 1200w, ${src.replace(/w=\d+/, "w=1800")} 1800w`;
const itemNumber = (index: number) => String(index + 1).padStart(2, "0");
const caseCount = (concept: (typeof published)[number]) =>
  formatConceptCaseCount(locale, zh ? concept.cases.filter((entry) => hasCaseLocale("zh", entry.id)).length : concept.cases.length);
---

<BaseLayout
  title={zh ? "概念" : "Concepts"}
  description={zh ? "问溯的分析概念：从真实商业情境中看见机制、压力与行动空间。" : "Understory's analytical concepts for seeing mechanisms, pressure, and room to act in real business situations."}
  locale={locale}
>
  <section class:list={["page-shell", "concepts-r10", { "concepts-r10--zh": zh }]} aria-labelledby="concepts-heading">
    <header class="concepts-r10__hero">
      <figure><img src={heroImage.src} srcset={responsiveSrc(heroImage.src)} sizes="100vw" alt={heroImage.alt} fetchpriority="high" /></figure>
      <div class="concepts-r10__hero-copy">
        <p class="concepts-r10__eyebrow">{zh ? "概念" : "Concepts"}</p>
        <h1 id="concepts-heading">{zh ? <>从表象出发，<br />看见背后的结构。</> : "From observation to structure."}</h1>
        <p>{zh ? "概念不是标签，而是帮助我们理解真实商业情境的分析工具；从现象出发，辨认结构，追溯机制，再回到案例中检验。" : "Concepts are analytical tools. They help us move from what we see to how markets, firms, and outcomes work."}</p>
      </div>
      <aside><p>{zh ? "从观察到判断" : "A clearer way to analyse"}</p><ol>{(zh ? ["看见现象", "命名概念", "追溯机制", "在案例中应用"] : ["See the phenomenon", "Name the concept", "Trace the mechanism", "Apply it in cases"]).map((step) => <li>{step}</li>)}</ol></aside>
    </header>

    {leadConcept && leadConcept.image && <section class="concepts-r10__lead" aria-labelledby="featured-concepts-heading">
      <div class="concepts-r10__lead-identity"><p>{itemNumber(0)}</p><span>{zh ? "核心概念" : "Core concept"}</span><h2 id="featured-concepts-heading">{leadConcept.title[locale]}</h2><p>{leadConcept.shortDefinition[locale]}</p><a href={localizedPath(locale, `/concepts/${leadConcept.slug}/`)}>{zh ? "了解这个概念" : "Explore this concept"} <i>→</i></a></div>
      <figure><img src={leadConcept.image.src} srcset={responsiveSrc(leadConcept.image.src)} sizes="(max-width: 840px) calc(100vw - 40px), 34vw" alt={leadConcept.image.alt[locale]} loading="eager" /><figcaption><span>{leadConcept.image.caption[locale]}</span><small>{leadConcept.image.credit}</small></figcaption></figure>
      <aside><p>{zh ? "这个概念真正回问的是：" : "A key question"}</p><h3>{leadConcept.keyQuestion[locale]}</h3>{zh && <p>即使市场上只有少数几家企业，竞争仍可能通过消费者行为、价格与创新，限制企业的行动空间。</p>}<small>{caseCount(leadConcept)}</small><a href={localizedPath(locale, `/concepts/${leadConcept.slug}/`)}>{zh ? "查看相关案例" : "View related cases"} <i>→</i></a></aside>
    </section>}

    {supportingConcepts.length > 0 && <section class="concepts-r10__supporting" aria-label={zh ? "其他精选概念" : "More featured concepts"}>
      {supportingConcepts.map((concept, index) => concept.image && <article>
        <figure><img src={concept.image.src} srcset={responsiveSrc(concept.image.src)} sizes="(max-width: 760px) calc(100vw - 40px), 26vw" alt={concept.image.alt[locale]} loading="lazy" /></figure>
        <div><p>{itemNumber(index + 1)}</p><h2>{concept.title[locale]}</h2><p>{concept.shortDefinition[locale]}</p><h3>{concept.keyQuestion[locale]}</h3><a href={localizedPath(locale, `/concepts/${concept.slug}/`)}>{zh ? "了解这个概念" : "Explore this concept"} <i>→</i></a></div>
      </article>)}
    </section>}

    <section class="concepts-r10__index" aria-labelledby="concept-index-heading">
      <header><p class="concepts-r10__eyebrow">{zh ? "全部概念" : "All concepts"}</p><h2 id="concept-index-heading">{zh ? "浏览所有概念" : "Explore all concepts"}</h2><p>{zh ? "这些概念构成我们跨案例使用的分析工具。随着案例与研究增加，索引会继续扩展。" : "A shared analytical toolkit across cases."}</p></header>
      <a class="concepts-r10__index-all" href="#concept-index-list">{zh ? "查看全部概念" : "View all concepts"} <i>→</i></a>
      <nav class="concepts-r10__filters" aria-label={zh ? "概念分类" : "Concept categories"}><a class="is-active" href="#concept-index-list">{zh ? "全部" : "All"}</a><a href="#concept-index-list">{zh ? "市场结构" : "Market structure"}</a><a href="#concept-index-list">{zh ? "企业策略" : "Firm strategy"}</a><a href="#concept-index-list">{zh ? "消费者行为" : "Consumer behaviour"}</a><a href="#concept-index-list">{zh ? "监管与政策" : "Regulation"}</a></nav>
      <div class="concepts-r10__index-list" id="concept-index-list">{published.map((concept, index) => <a href={localizedPath(locale, `/concepts/${concept.slug}/`)}>{concept.image && <img src={concept.image.src} alt="" loading="lazy" />}<div><span>{itemNumber(index)}</span><h3>{concept.title[locale]}</h3><p>{concept.shortDefinition[locale]}</p><small>{caseCount(concept)}</small></div><i>→</i></a>)}</div>
    </section>
  </section>
</BaseLayout>
