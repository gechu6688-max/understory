---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const publishedCases = await getCollection("cases", ({ data }) => data.status === "published");
---

<BaseLayout title="V1 Foundation" description="Minimal Astro project foundation for structured business cases.">
  <section class="space-y-5">
    <p class="text-sm font-semibold uppercase tracking-wide text-slate-500">Foundation build</p>
    <h1 class="text-4xl font-semibold tracking-normal text-slate-950">Astro content foundation</h1>
    <p class="max-w-2xl text-lg leading-8 text-slate-700">
      This page is intentionally neutral. It proves that published case content can be listed from Astro Content Collections.
    </p>
  </section>

  <section class="mt-10">
    <h2 class="text-2xl font-semibold text-slate-950">Published Cases</h2>
    <ul class="mt-4 space-y-4">
      {
        publishedCases.map((caseEntry) => (
          <li class="rounded border border-slate-200 bg-white p-5">
            <a class="text-lg font-semibold text-slate-950 underline decoration-slate-300 underline-offset-4 hover:decoration-slate-700" href={`/cases/${caseEntry.id}/`}>
              {caseEntry.data.title}
            </a>
            <p class="mt-2 text-slate-700">{caseEntry.data.summary}</p>
            <p class="mt-3 text-sm text-slate-500">Status: {caseEntry.data.status}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
