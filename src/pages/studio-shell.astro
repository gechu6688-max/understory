<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Creator Studio · Understory</title>
    <link rel="stylesheet" href="/studio.css" />
  </head>
  <body>
    <main class="studio" data-studio>
      <header class="studio__header"><a class="studio__brand" href="/en/">understory <span>Creator Studio</span></a><div class="studio__identity" data-identity>Checking access…</div></header>
      <div class="studio__layout">
        <aside class="studio__sidebar"><button data-new="page">New page</button><button data-new="case">New case</button><button data-media>Media library</button><p>Editorial controls keep the public reading system intact.</p></aside>
        <section class="studio__workspace">
          <div class="studio__toolbar"><h1 data-heading>Content</h1><span data-status></span></div>
          <div class="studio__notice" data-notice hidden></div>
          <div class="studio__documents" data-documents></div>
          <form class="studio__editor" data-editor hidden>
            <div class="studio__editor-heading"><h2 data-editor-title>New document</h2><button type="button" data-close>Close</button></div>
            <label>Title <input name="title" required /></label><label>Slug <input name="slug" required /></label>
            <label>Locale <select name="locale"><option value="en">English</option><option value="zh">中文</option></select></label>
            <label>Status <select name="status"><option value="draft">Draft</option><option value="review">Review</option><option value="archived">Archived</option></select></label>
            <div data-case-fields hidden>
              <fieldset><legend>Amazon Case Hero</legend><label>Hero title <input data-hero="title" required /></label><label>Summary <textarea data-meta="summary"></textarea></label><label>Central question <textarea data-meta="centralQuestion"></textarea></label><label>Hero image URL <input data-hero="image" /></label><label>Hero alt text <input data-hero="alt" /></label><label>Hero caption <input data-hero="caption" /></label><div data-hero-layouts></div></fieldset>
              <div data-blocks></div><button type="button" data-add-block>Add editorial section</button>
            </div>
            <label data-raw-content>Structured content <textarea name="content" rows="20" required></textarea></label>
            <div class="studio__actions"><button>Save draft</button><button type="button" data-preview>Preview draft</button><button type="button" data-publish>Publish / Update</button><button type="button" data-versions>Version history</button><button type="button" data-delete>Delete</button></div>
          </form>
          <section data-media-panel hidden><button type="button" data-close-media>Close</button><form data-media-form><input name="file" type="file" accept="image/*" required /><input name="alt" required /><input name="caption" /><button>Upload</button></form><div data-media-list></div></section>
        </section>
      </div>
    </main>
    <script is:inline src="/studio.js" defer></script>
  </body>
</html>
