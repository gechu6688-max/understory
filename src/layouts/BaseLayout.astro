---
import "../styles/global.css";
import { siteCopy } from "../lib/siteCopy";

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteCopy.brand.descriptor } = Astro.props;
const pathname = Astro.url.pathname;
const isPreview = !import.meta.env.PROD;
const navItems = siteCopy.nav;

const isActive = (section: string) => pathname === section || pathname.startsWith(section);
---

<!doctype html>
<html lang={siteCopy.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <header class="site-header">
      <nav class="site-nav" aria-label="Primary navigation">
        <a class="site-identity" href="/" aria-label={`${siteCopy.brand.name} home`}>{siteCopy.brand.name}</a>
        <div class="site-nav__actions">
          <div class="site-nav__links">
          {
            navItems.map((item) => (
              <a class={isActive(item.section) ? "is-active" : undefined} href={item.href} aria-current={isActive(item.section) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          {isPreview && <a class="site-nav__preview" href="/preview/">Local Preview</a>}
          </div>
          <div class="site-locale-slot" aria-hidden="true"></div>
        </div>
        <details class="site-menu">
          <summary>Menu</summary>
          <div class="site-menu__panel">
            {
              navItems.map((item) => (
                <a class={isActive(item.section) ? "is-active" : undefined} href={item.href} aria-current={isActive(item.section) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
            {isPreview && <a class="site-nav__preview site-menu__preview-link" href="/preview/">Local Preview</a>}
          </div>
        </details>
      </nav>
    </header>
    <main class="mx-auto max-w-5xl px-5 py-8 sm:py-12">
      <slot />
    </main>
  </body>
</html>
