---
interface Props {
  src: string;
  alt: string;
  label?: string;
  caption?: string;
  credit?: string;
  sourceHref?: string;
  license?: string;
  licenseHref?: string;
  variant?: "body" | "hero";
}

const {
  src,
  alt,
  label = "System View",
  caption,
  credit,
  sourceHref,
  license,
  licenseHref,
  variant = "body",
} = Astro.props;
---

<figure class:list={["case-editorial-image", `case-editorial-image--${variant}`]}>
  <div class="case-editorial-image__frame">
    <img src={src} alt={alt} loading={variant === "hero" ? "eager" : "lazy"} decoding="async" />
  </div>
  {
    (label || caption || credit) && (
      <figcaption>
        <span class="case-editorial-image__label">{label}</span>
        {caption && <span class="case-editorial-image__caption">{caption}</span>}
        {
          (credit || license) && (
            <span class="case-editorial-image__credit">
              {sourceHref ? <a href={sourceHref}>{credit}</a> : credit}
              {credit && license && <span aria-hidden="true"> · </span>}
              {licenseHref ? <a href={licenseHref}>{license}</a> : license}
            </span>
          )
        }
      </figcaption>
    )
  }
</figure>
