---
interface BoundaryItem {
  label: string;
  detail: string;
}

import ResearchMark from "../../discovery/ResearchMark.astro";

interface Props {
  label?: string;
  title: string;
  items: BoundaryItem[];
}

const {
  label = "Analytical Boundary",
  title,
  items,
} = Astro.props;
---

<section class="case-boundary-map case-boundary-map--v4" aria-label={title}>
  <header>
    <p><ResearchMark kind="boundary" />{label}</p>
    <h3>{title}</h3>
  </header>
  <div>
    {items.map((item, index) => (
      <article>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <h4>{item.label}</h4>
        <p>{item.detail}</p>
      </article>
    ))}
  </div>
</section>
