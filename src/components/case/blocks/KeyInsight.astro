---
interface Props {
  title?: string;
  statement?: string;
  scopeBoundary?: string;
  label?: string;
}

const {
  title = "Key Insight",
  statement,
  scopeBoundary,
  label = "Current Judgment",
} = Astro.props;
---

{
  statement ? (
    <aside class="case-key-insight" aria-labelledby="case-key-insight-title">
      <p class="case-key-insight__label">{label}</p>
      <div class="case-key-insight__body">
        <h2 id="case-key-insight-title">{title}</h2>
        <p class="case-key-insight__statement">{statement}</p>
        {scopeBoundary && (
          <p class="case-key-insight__scope"><span>Scope boundary</span>{scopeBoundary}</p>
        )}
      </div>
    </aside>
  ) : (
    <aside class="my-10 border-y border-[var(--color-border)] py-6 text-[var(--color-text)]">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-judgement)]">{title}</p>
      <div class="mt-3 border-l-2 border-[var(--color-judgement)] pl-5 text-lg leading-8">
        <slot />
      </div>
    </aside>
  )
}
