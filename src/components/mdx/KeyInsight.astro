---
interface Props {
  title?: string;
}

const { title = "Key Insight" } = Astro.props;
---

<aside class="my-10 border-y border-[var(--color-border)] py-6 text-[var(--color-text)]">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-judgement)]">{title}</p>
  <div class="mt-3 border-l-2 border-[var(--color-judgement)] pl-5 text-lg leading-8">
    <slot />
  </div>
</aside>
