---
interface Props {
  title?: string;
}

const { title = "Key Insight" } = Astro.props;
---

<aside class="my-6 border-l-4 border-sky-500 bg-sky-50 px-5 py-4 text-slate-900">
  <p class="text-sm font-semibold uppercase tracking-wide text-sky-800">{title}</p>
  <div class="mt-2 text-base leading-7">
    <slot />
  </div>
</aside>
