---
interface Props {
  label?: string;
}

const { label = "Evidence" } = Astro.props;
---

<section class="my-8 border-l-2 border-[var(--color-evidence)] bg-[#eef7f3] px-5 py-4">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-evidence)]">{label}</p>
  <div class="mt-2 text-base leading-7 text-[var(--color-text)]">
    <slot />
  </div>
</section>
