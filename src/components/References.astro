---
import type { CollectionEntry } from "astro:content";

type Source = CollectionEntry<"cases">["data"]["sources"][number];

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "short",
        day: "numeric",
      }).format(date)
    : undefined;
---

<section aria-labelledby="references-heading" class="mt-14 max-w-[var(--measure-wide)] border-t border-[var(--color-border)] pt-8">
  <h2 id="references-heading" class="text-2xl font-semibold tracking-tight text-[var(--color-text)]">References</h2>
  <ol class="mt-5 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
    {
      sources.map((source, index) => (
        <li class="grid gap-3 py-5 sm:grid-cols-[3rem_minmax(0,1fr)]" id={source.id}>
          <span class="font-serif text-lg text-[var(--color-text-muted)]">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[var(--color-text-muted)]">{source.publisher} · {source.sourceType}</p>
            <p class="mt-2 font-semibold leading-7 text-[var(--color-text)]">
              {source.url ? (
                <a class="underline decoration-[var(--color-border)] underline-offset-4 hover:decoration-[var(--color-accent)]" href={source.url}>
                  {source.title}
                </a>
              ) : (
                source.title
              )}
            </p>
            <p class="mt-1 text-sm text-[var(--color-text-muted)]">
              {formatDate(source.publicationDate) ? `Published ${formatDate(source.publicationDate)}` : ""}
              {formatDate(source.publicationDate) && formatDate(source.accessDate) ? " · " : ""}
              {formatDate(source.accessDate) ? `Accessed ${formatDate(source.accessDate)}` : ""}
            </p>
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-secondary)]">{source.relevanceNote}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
