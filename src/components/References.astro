---
import type { CollectionEntry } from "astro:content";

type Source = CollectionEntry<"cases">["data"]["sources"][number];

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

const formatDate = (date?: Date) =>
  date
    ? new Intl.DateTimeFormat("en", {
        year: "numeric",
        month: "short",
        day: "numeric",
      }).format(date)
    : undefined;
---

<section aria-labelledby="references-heading" class="mt-12 border-t border-slate-200 pt-8">
  <h2 id="references-heading" class="text-2xl font-semibold text-slate-950">References</h2>
  <ol class="mt-4 space-y-5">
    {
      sources.map((source) => (
        <li class="rounded border border-slate-200 bg-white p-4" id={source.id}>
          <p class="font-semibold text-slate-950">
            {source.url ? (
              <a class="underline decoration-slate-300 underline-offset-4 hover:decoration-slate-700" href={source.url}>
                {source.title}
              </a>
            ) : (
              source.title
            )}
          </p>
          <p class="mt-1 text-sm text-slate-600">
            {source.publisher} · {source.sourceType}
            {formatDate(source.publicationDate) ? ` · Published ${formatDate(source.publicationDate)}` : ""}
            {formatDate(source.accessDate) ? ` · Accessed ${formatDate(source.accessDate)}` : ""}
          </p>
          <p class="mt-2 text-sm leading-6 text-slate-700">{source.relevanceNote}</p>
        </li>
      ))
    }
  </ol>
</section>
