---
interface Props {
  href: string;
  company: string;
  eyebrow: string;
  headline: string;
  summary: string;
  cta: string;
  image: string;
  locale: "en" | "zh";
  panelTitle: string;
  panelItems: string[];
}

const { href, company, eyebrow, headline, summary, cta, image, locale, panelTitle, panelItems } = Astro.props;
---

<section class="editorial-hero" aria-labelledby="featured-case-title" data-featured-slider data-slide-count="1">
  <a class="editorial-hero__link" href={href} aria-label={`${cta}: ${company} — ${headline}`}>
    <img class="editorial-hero__image" src={image} alt={locale === "zh" ? "仓库内的物流传送线与货架系统" : "A vast logistics system of conveyor lines and shelving inside a warehouse"} fetchpriority="high" />
    <span class="editorial-hero__shade" aria-hidden="true"></span>
    <span class="editorial-hero__panel" aria-hidden="true">
      <span class="editorial-hero__panel-title">{panelTitle}</span>
      <span class="editorial-hero__panel-list">
        {panelItems.map((item) => <span>→ <b>{item}</b></span>)}
      </span>
    </span>
    <span class="editorial-hero__content">
      <span class="editorial-hero__eyebrow">{eyebrow}</span>
      <span class="editorial-hero__company">{company}</span>
      <span class="editorial-hero__headline" id="featured-case-title" data-cms="heroHeadline">{headline}</span>
      <span class="editorial-hero__summary" data-cms="heroSummary">{summary}</span>
      <span class="editorial-hero__cta" data-cms="exploreCase">{cta}<span aria-hidden="true">→</span></span>
    </span>
  </a>
</section>
