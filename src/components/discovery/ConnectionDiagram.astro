---
import type { Locale } from "../../lib/siteCopy";
import { localizedPath } from "../../lib/siteCopy";
const { locale, mode = "case" } = Astro.props as { locale: Locale; mode?: "case" | "concept" };
const zh = locale === "zh";
---
<div class:list={["connection-diagram", `connection-diagram--${mode}`]}>
  {mode === "case" ? <>
    <a class="connection-diagram__case" href={localizedPath(locale, "/cases/amazon-convenience-market-power/")}><small>{zh ? "案例" : "Case"} 001</small><strong>Amazon</strong></a>
    <a class="connection-diagram__topic connection-diagram__topic--competition" href={localizedPath(locale, "/topics/competition/")}>{zh ? "竞争" : "Competition"}</a>
    <a class="connection-diagram__topic connection-diagram__topic--power" href={localizedPath(locale, "/topics/market-power/")}>{zh ? "市场力量" : "Market Power"}</a>
    <a class="connection-diagram__concept connection-diagram__concept--pricing" href={localizedPath(locale, "/concepts/pricing-power/")}>{zh ? "定价权" : "Pricing Power"}</a>
    <a class="connection-diagram__concept connection-diagram__concept--constraint" href={localizedPath(locale, "/concepts/competitive-constraint/")}>{zh ? "竞争约束" : "Competitive Constraint"}</a>
    <a class="connection-diagram__concept connection-diagram__concept--switching" href={localizedPath(locale, "/concepts/switching-costs/")}>{zh ? "转换成本" : "Switching Costs"}</a>
  </> : <>
    <a class="connection-diagram__topic connection-diagram__topic--power" href={localizedPath(locale, "/topics/market-power/")}>{zh ? "市场力量" : "Market Power"}</a>
    <a class="connection-diagram__concept connection-diagram__concept--constraint" href={localizedPath(locale, "/concepts/competitive-constraint/")}>{zh ? "竞争约束" : "Competitive Constraint"}</a>
    <a class="connection-diagram__concept connection-diagram__concept--pricing" href={localizedPath(locale, "/concepts/pricing-power/")}>{zh ? "定价权" : "Pricing Power"}</a>
    <a class="connection-diagram__concept connection-diagram__concept--switching" href={localizedPath(locale, "/concepts/switching-costs/")}>{zh ? "转换成本" : "Switching Costs"}</a>
  </>}
</div>
