---
const { concept, locale } = Astro.props as { concept: string; locale: "en" | "zh" };
const zh = locale === "zh";
---
<div class:list={["field-mechanism", `field-mechanism--${concept}`]} aria-label={zh ? "概念机制图" : "Concept mechanism diagram"}>
  {concept === "competitive-constraint" && <><small>{zh?"约束机制":"Mechanism of discipline"}</small><div class="constraint-options"><b>{zh?"竞争者 A":"Rival A"}</b><b>{zh?"竞争者 B":"Rival B"}</b><b>{zh?"可行替代":"Workable alternative"}</b></div><i class="mechanism-verb">{zh?"外部选择施加压力 ↓":"Outside options apply pressure ↓"}</i><strong>{zh?"企业":"Firm"}</strong><span>{zh?"价格 / 条款 / 质量":"Price / terms / quality"}</span></>}
  {concept === "pricing-power" && <><small>{zh?"概念说明，并非经验图表":"Conceptual explanation — not empirical data"}</small><div class="pricing-path"><b>{zh?"条件变化":"Terms change"}</b><i>→</i><b>{zh?"需求仍然留存？":"Demand retained?"}</b><i>→</i><strong>{zh?"行动空间":"Room to act"}</strong></div><span>{zh?"留存越多，持续改变条件的空间越大。":"More retained demand means more room to sustain changed terms."}</span></>}
  {concept === "switching-costs" && <><small>{zh?"摩擦场":"Friction field"}</small><b class="switch-origin">{zh?"当前选择":"Current option"}</b><i class="mechanism-verb">↓</i><div class="friction-band"><strong>{zh?"迁移成本 / 摩擦":"Cost / friction of moving"}</strong><div><i>{zh?"时间":"Time"}</i><i>{zh?"数据":"Data"}</i><i>{zh?"学习":"Learning"}</i><i>{zh?"关系":"Relationships"}</i><i>{zh?"运营中断":"Operational disruption"}</i></div></div><i class="mechanism-verb">↓</i><b class="switch-destination">{zh?"替代选择":"Alternative"}</b><span>{zh?"离开并不只是点击另一个选项。":"Leaving is more than clicking another option."}</span></>}
</div>
