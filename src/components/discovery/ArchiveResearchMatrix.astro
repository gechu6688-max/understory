---
import type { Locale } from "../../lib/siteCopy";
import { localizedPath } from "../../lib/siteCopy";
const { locale } = Astro.props as { locale: Locale };
const zh = locale === "zh";
const labels = zh
  ? { case: "案例", topic: "主题", concept: "概念", evidence: "证据线索", pressure: "压力", constraint: "约束", room: "行动空间", friction: "转换摩擦", amazon: "亚马逊", competition: "竞争", power: "市场力量", pricing: "定价能力", switching: "转换成本", competitive: "竞争约束" }
  : { case: "Case", topic: "Topic", concept: "Concept", evidence: "Evidence trace", pressure: "pressure", constraint: "constraint", room: "room to act", friction: "switching friction", amazon: "Amazon", competition: "Competition", power: "Market Power", pricing: "Pricing Power", switching: "Switching Costs", competitive: "Competitive Constraint" };
---
<div class="archive-matrix" aria-label={zh ? "案例、主题与概念的研究矩阵" : "Research matrix joining case, topics, and concepts"}>
  <div class="archive-matrix__key" aria-hidden="true"><span><i></i>{labels.case}</span><span><i></i>{labels.topic}</span><span><i></i>{labels.concept}</span></div>
  <svg viewBox="0 0 1000 600" role="img" aria-label={zh ? "亚马逊案例连接竞争、市场力量、竞争约束、定价能力和转换成本" : "Amazon case connects competition, market power, competitive constraint, pricing power, and switching costs"}>
    <defs><pattern id="matrix-grid" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M 50 0 L 0 0 0 50" fill="none" /></pattern><marker id="matrix-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker></defs>
    <rect class="archive-matrix__grid" width="1000" height="600" />
    <g class="archive-matrix__coordinates"><text x="80" y="46">01 / {labels.case.toUpperCase()}</text><text x="420" y="46">02 / {labels.topic.toUpperCase()}</text><text x="746" y="46">03 / {labels.concept.toUpperCase()}</text><text x="24" y="132">A</text><text x="24" y="312">B</text><text x="24" y="492">C</text></g>
    <g class="archive-matrix__routes" aria-hidden="true"><path d="M284 286 C354 286 360 176 446 176"/><path d="M284 302 C352 302 360 424 446 424"/><path d="M596 176 C666 176 678 142 752 142"/><path d="M596 190 C668 190 684 292 752 292"/><path d="M596 424 C668 424 680 306 752 306"/><path class="is-secondary" d="M596 424 C672 424 688 454 752 454"/></g>
    <g class="archive-matrix__annotations"><text x="334" y="219">{labels.pressure}</text><text x="666" y="134">{labels.constraint}</text><text x="665" y="270">{labels.room}</text><text x="665" y="478">{labels.friction}</text></g>
    <a href={localizedPath(locale, "/cases/amazon-convenience-market-power/")} class="archive-matrix__node archive-matrix__node--case"><rect x="82" y="232" width="202" height="126"/><text x="106" y="263">CASE 001</text><text class="archive-matrix__title" x="106" y="314">{labels.amazon.toUpperCase()}</text><text x="106" y="338">{labels.evidence.toUpperCase()}</text></a>
    <a href={localizedPath(locale, "/topics/competition/")} class="archive-matrix__node archive-matrix__node--topic"><rect x="446" y="124" width="150" height="104"/><text x="466" y="151">T-01</text><text class="archive-matrix__title" x="466" y="187">{labels.competition.toUpperCase()}</text><text x="466" y="208">{labels.topic.toUpperCase()}</text></a>
    <a href={localizedPath(locale, "/topics/market-power/")} class="archive-matrix__node archive-matrix__node--topic"><rect x="446" y="372" width="150" height="104"/><text x="466" y="399">T-02</text><text class="archive-matrix__title" x="466" y="435">{labels.power.toUpperCase()}</text><text x="466" y="456">{labels.topic.toUpperCase()}</text></a>
    <a href={localizedPath(locale, "/concepts/competitive-constraint/")} class="archive-matrix__node archive-matrix__node--concept"><circle cx="804" cy="142" r="54"/><text x="804" y="135">C-01</text><text class="archive-matrix__title" x="804" y="157">{zh ? "竞争约束" : "CONSTRAINT"}</text></a>
    <a href={localizedPath(locale, "/concepts/pricing-power/")} class="archive-matrix__node archive-matrix__node--concept"><circle cx="804" cy="300" r="54"/><text x="804" y="293">C-02</text><text class="archive-matrix__title" x="804" y="315">{zh ? "定价能力" : "PRICING"}</text></a>
    <a href={localizedPath(locale, "/concepts/switching-costs/")} class="archive-matrix__node archive-matrix__node--concept"><circle cx="804" cy="458" r="54"/><text x="804" y="451">C-03</text><text class="archive-matrix__title" x="804" y="473">{zh ? "转换成本" : "SWITCHING"}</text></a>
    <g class="archive-matrix__marks" aria-hidden="true"><path d="M325 286h18M334 277v18"/><path d="M637 176h18M646 167v18"/><path d="M637 424h18M646 415v18"/></g>
  </svg>
</div>
