---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import References from "./References.astro";
import KeyInsight from "./mdx/KeyInsight.astro";
import { formatCaseStatus, formatCaseType, getCaseDisplayData } from "../lib/cases";
import { defaultLocale, getSiteCopy, type Locale } from "../lib/siteCopy";

interface Props {
  caseEntry: CollectionEntry<"cases">;
  previewLabel?: string;
  locale?: Locale;
}

const { caseEntry, previewLabel, locale = defaultLocale } = Astro.props;
const { Content } = await render(caseEntry);
const { data } = caseEntry;
const displayData = getCaseDisplayData(caseEntry, locale);
const copy = getSiteCopy(locale);
const isAmazonEditorialEn = locale === "en" && caseEntry.id === "amazon-convenience-market-power";

const publishedDate = new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(data.publishedDate);
---

<article class:list={{ "amazon-case-en": isAmazonEditorialEn }}>
  {
    previewLabel && (
      <aside class="mb-8 max-w-[var(--measure-wide)] border-l-2 border-[var(--color-uncertainty)] bg-[#fff8ea] px-4 py-3 text-[var(--color-text)]">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-uncertainty)]">{previewLabel}</p>
        <p class="mt-1 text-sm text-[var(--color-text-secondary)]">This route is for local content review. It is not a public production case route.</p>
      </aside>
    )
  }

  <header class:list={["case-header max-w-[var(--measure-wide)] border-b border-[var(--color-border)]", isAmazonEditorialEn ? "case-header--editorial pb-8" : "pb-10"]}>
    {
      isAmazonEditorialEn ? (
        <div class="case-archive-meta">
          <p><span>Case 001</span><span>Published analysis</span></p>
          <p>{formatCaseType(data.caseType, locale)} · {publishedDate}</p>
        </div>
      ) : (
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-text-muted)]">{copy.labels.caseStatus}: {formatCaseStatus(data.status, locale)} · {formatCaseType(data.caseType, locale)} · {publishedDate}</p>
      )
    }
    <h1 class:list={["max-w-4xl font-serif font-semibold leading-[1.04] tracking-normal text-[var(--color-text)]", isAmazonEditorialEn ? "mt-7 text-[2.8rem] sm:text-[4.6rem]" : "mt-5 text-[2.65rem] sm:text-[4.35rem]"]}>{displayData.title}</h1>
    {
      isAmazonEditorialEn ? (
        <p class="case-header__deck">{displayData.summary}</p>
      ) : (
        <>
          {displayData.subtitle && <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-secondary)] sm:text-xl">{displayData.subtitle}</p>}
          <p class="mt-6 max-w-[var(--measure-article)] text-lg leading-8 text-[var(--color-text-secondary)]">{displayData.summary}</p>
        </>
      )
    }

    {!isAmazonEditorialEn && (
      <div class="case-header__argument mt-9 grid gap-7 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
        <section class="case-header__question border-t-2 border-[var(--color-accent)] pt-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">{copy.labels.centralQuestion}</p>
          <p class="mt-3 text-xl leading-8 text-[var(--color-text)] sm:text-2xl">{displayData.centralQuestion}</p>
        </section>
        <section class="case-header__thesis border-l border-[var(--color-border)] pl-5 max-lg:border-l-0 max-lg:border-t max-lg:pl-0 max-lg:pt-5">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-text-muted)]">{copy.labels.quickThesis}</p>
          <p class="mt-3 text-lg leading-8 text-[var(--color-text)]">{displayData.quickThesis}</p>
        </section>
      </div>
    )}

    <dl class:list={["case-taxonomy grid text-sm sm:grid-cols-3", isAmazonEditorialEn ? "case-taxonomy--quiet mt-7 gap-3" : "mt-8 gap-4"]}>
      <div>
        <dt class="font-semibold uppercase tracking-[0.14em] text-[var(--color-text-muted)]">{copy.labels.entities}</dt>
        <dd class="mt-2 leading-6 text-[var(--color-text-secondary)]">
          <ul class="case-taxonomy__items">
            {displayData.entities.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div>
        <dt class="font-semibold uppercase tracking-[0.14em] text-[var(--color-text-muted)]">{copy.labels.topics}</dt>
        <dd class="mt-2 leading-6 text-[var(--color-text-secondary)]">
          <ul class="case-taxonomy__items">
            {displayData.topics.slice(0, 3).map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
      <div>
        <dt class="font-semibold uppercase tracking-[0.14em] text-[var(--color-text-muted)]">{copy.labels.concepts}</dt>
        <dd class="mt-2 leading-6 text-[var(--color-text-secondary)]">
          <ul class="case-taxonomy__items">
            {displayData.concepts.slice(0, 3).map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </div>
    </dl>
  </header>

  {
    isAmazonEditorialEn && (
      <>
        <section class="case-central-question" aria-labelledby="case-central-question-title">
          <p class="case-central-question__label">Central Question</p>
          <h2 id="case-central-question-title">{displayData.centralQuestion}</h2>
          <p>Amazon delivers real benefits to consumers. This case asks whether those benefits change when a meaningful competitive constraint disappears.</p>
        </section>
        <KeyInsight
          title="The consumer benefit is conditional"
          statement={displayData.quickThesis}
          scopeBoundary="The post-exit pricing evidence does not prove predatory pricing or explain every individual price change."
        />
      </>
    )
  }

  <div class:list={["case-body max-w-[var(--measure-article)]", isAmazonEditorialEn ? "mt-16" : "mt-12"]}>
    <Content />
  </div>

  <References sources={data.sources} locale={locale} />
</article>
